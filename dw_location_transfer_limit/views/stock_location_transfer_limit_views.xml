<odoo>
    <record id="stock_location_transfer_limit_list" model="ir.ui.view">
        <field name="name">stock.location.transfer.limit.list</field>
        <field name="model">stock.location.transfer.limit</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="perform_transfer"/>
            </tree>
        </field>
    </record>
    <record id="action_stock_location_transfer_limit" model="ir.actions.act_window">
        <field name="name">Transfer Limits</field>
        <field name="res_model">stock.location.transfer.limit</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>