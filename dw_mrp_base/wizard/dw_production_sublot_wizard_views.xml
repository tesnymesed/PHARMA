<odoo>
    <record id="view_mrp_production_sublot_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.sublot.wizard.form</field>
        <field name="model">mrp.production.sublot</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_backorder_form"/>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="new_sublot" string="add sublot "/>
                        <field name="sublot_id" String="Sublot/Serial number" invisible=" new_sublot == False "/>
                    </group>
                    <footer>
                        <button name="backorder" string="Create backorder" action="action_backorer" type="object" invisible="not new_sublot"/>
                        <button name="no_backorder" string="No backorder" action="action_skip_backorder" type="object" invisible="new_sublot"/>
                        <button name="discard" string="Discard" action="action_close" type="object" special="cancel"/>
                    </footer>
                </sheet>
            </form>

        </field>
    </record>

    <record id="action_mrp_production_sublot_wizard" model="ir.actions.act_window">
        <field name="name">Create Sublot</field>
        <field name="res_model">dw.mrp.production.sublot</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mrp_production_sublot_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>