<odoo>
    <record id="view_mrp_production_sublot_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.sublot.wizard.form</field>
        <field name="model">mrp.production.sublot.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Sublot">
                <group>
                    <field name="sublot_id" String="Sublot number"/>
                </group>
                <footer>
                    <button string="confirm sublot" type="object" name="action_confirmsublot"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mrp_production_sublot_wizard" model="ir.actions.act_window">
        <field name="name">Create Sublot</field>
        <field name="res_model">mrp.production.sublot</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mrp_production_sublot_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>