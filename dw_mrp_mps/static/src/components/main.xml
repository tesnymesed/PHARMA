<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-inherit="mrp_mps.mrp_mps" t-inherit-mode="extension" owl="1">
    <xpath expr="//button[contains(text(), 'Add a Product')]" position="after">
      <input
        type="text"
        style="width: 180px"
        class="btn btn-primary"
        name="daterange"
        id="daterange"
        value="01/01/2024 - 01/01/2025"
      />
      <button
        t-if="lines.length"
        type="show-alerts"
        id="show-alerts"
        class="btn btn-primary"
        t-on-click="toggleModal"
      >
        Display Alerts
      </button>
    </xpath>
  </t>
</templates>
