<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dw.mrp.mps</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='mrp_mps']" position="after">
                <setting id="dw_manufacturing_period_start" string="Time Range Start" company_dependent="1"
                         help="Pick the date from which manufacturing Periods begin."
                         invisible="not module_mrp_mps">
                    <div class="content-group" invisible="not module_mrp_mps">
                        <field name="manufacturing_period_start" widget="radio" class="o_light_label"/>
                    </div>
                </setting>
            </xpath>

            <xpath expr="//setting[@id='security_lead_time']" position="after">
                <setting id="dw_product_lead_time" string="Product Lead Time" company_dependent="1"
                         help="Take into account products lead time to schedule Purchase orders."
                         invisible="not use_manufacturing_lead">
                    <field name="dw_use_product_lead"/>
                    <div id="dw_product_lead_settings" class="content-group" invisible="not dw_use_product_lead">
                        <div class="mt8">
                            <button name="%(dw_mrp_mps.dw_product_lead_time_action)d" icon="oi-arrow-right"
                                    type="action" string="Product Purchase Lead Times" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </xpath>

        </field>
    </record>
</odoo>
