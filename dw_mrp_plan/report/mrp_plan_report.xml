        <record id="action_mrp_plan_report" model="ir.actions.report">
            <field name="name">Mrp Plan Report</field>
            <field name="model">mrp.plan</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">dw_mrp_plan.mrp_plan_report_document</field>
            <field name="report_file">dw_mrp_plan.mrp_plan_report_document</field>
            <field name="print_report_name">'Mrp Plan Report - %s ' % object.name</field>
            <field name="binding_model_id" ref="dw_mrp_plan.model_mrp_plan"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_mrp_plan_monthly_report" model="ir.actions.report">
