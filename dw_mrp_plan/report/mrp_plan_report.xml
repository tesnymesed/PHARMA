<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="mrp_plan_report_document">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-foreach="docs" t-as="o">
                        <div class="page">
                            <table class="table table bordered">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Prévision U.V</th>
                                        <t t-set="dates" t-value="o.get_month_year()"/>
                                        <t t-foreach="dates" t-as="date">
                                            <th>
                                                <span t-esc="date"/>
                                            </th>
                                        </t>
                                    </tr>
                                </thead>
                                <t t-foreach="o.product_plan_ids" t-as="product_plan">
                                    <tr>
                                        <td>
                                            <span t-field="product_plan.product_id.display_name"/>
                                        </td>
                                        <td>
                                            <span t-field="product_plan.quantity"/>
                                        </td>
                                        <t t-foreach="product_plan.monthly_plan_ids" t-as="monthly_plan">
                                            <td>
                                                <span t-field="monthly_plan.quantity"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

