<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="owl.OwlMainDashboard" owl="1">
        <div class="container">
            <div class="row">
                <div class="card">
                  <div class="card-body">
                      <h2>MRP</h2>
                      <div class="row">
                          <div class="col-sm-3">
                                <label for="select-mrp-plan" class="form-label">Select MRP Plan</label>
                                <select class="form-select" id="select-mrp-plan" data-placeholder="Select Mrp Plan ...">
                                </select>
                          </div>
                      </div>
                      <!--                      Modal For Weekly Plan-->
                    <div class="modal fade" id="WeeklyPlaModel" tabindex="-1" aria-labelledby="ModalLabel" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-scrollable modal-xl">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">Weekly MRP Plan</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body" id="WeeklyPlanmodalBody">
                            <center><h3 id="weeklytableTitle"></h3></center>
                          </div>
                        </div>
                      </div>
                    </div>
<!--                      End modal weekly plan-->
                            <!-- Modal For PDP Validation-->
                    <div class="modal fade" id="PDPValidationModel" tabindex="-1" aria-labelledby="ModalLabel" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-scrollable modal-xl">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">Product MRP Plan Validation</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body" id="PDPValidationmodalBody">
                    <!--          Body -->
                            <center><h3 id="tableTitle"></h3></center>
                            <table class="table table-striped">
                              <thead id="tableHead">
                              </thead>
                              <tbody id="tableBody">
                              </tbody>
                            </table>
                <!--          Body End-->
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="button" id="save" class="btn btn-primary">Validate</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
            <div class="row">
                <div class="card">
                    <div class="card-body">
                      <div id="tab" class="table table-hover"></div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>