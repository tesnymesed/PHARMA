<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Client action  -->
    <record id="action_product_mrp_plan" model="ir.actions.client">
        <field name="name">Product Mrp Plan</field>
        <field name="tag">mrp_plan</field>
        <field name="target">new</field>
    </record>

    <record id="view_mrp_plan_form" model="ir.ui.view">
        <field name="name">mrp.plan.form</field>
        <field name="model">mrp.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Monthly Product QTY" name="run_action" type="object"/>
                    <button type="object" name="action_done" string="Mark as Done" class="oe_highlight"
                            invisible="state == 'done'"/>
                    <!--                    <button name="action_import_excel_view" string="Import Excel" type="object"/>-->
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <div class="oe_button_box" name="button_box">
                    <button
                            type="object"
                            name="action_print"
                            class="oe_stat_button"
                            icon="fa-folder-open-o"
                            string="Overview"
                    />
                    <button
                            type="object"
                            name="action_display_all_roadmaps"
                            class="oe_stat_button"
                            icon="fa-sitemap"
                            string="Roadmaps"
                    />
                </div>
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group name="season_date_grp">
                        <field name="season_date" required="1"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>

                <notebook>
                    <page name="product_plan" string="Product Plan">
                        <field name="product_plan_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="product_id" required="1"/>
                                <field name="bom_id" required="1"/>
                                <field name="quantity" readonly="1" force_save="1"/>
                                <field name="uom_id" optional="hide"/>
                                <button name="action_view_quantity_by_month" type="object" class="oe_stat_button"
                                        icon="fa-list"/>
                                <button name="print_plan_summary_report" type="object" icon="fa-desktop"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="view_mrp_plan_months_form" model="ir.ui.view">
        <field name="name">product.mrp.plan.tree</field>
        <field name="model">product.mrp.plan</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0">
                <field name="roadmap_id" column_invisible="1"/>
                <field name="mrp_state" column_invisible="1"/>
                <field name="product_plan_id" column_invisible="1"/>
                <field name="date" readonly="1" force_save="1"/>
                <field name="product_id" readonly="1" force_save="1"/>
                <field name="start_quantity" column_invisible="1" force_save="1"/>
                <field name="expected_start_quantity"/>
                <field name="unexpected_quantity" optional="hide"
                       readonly="roadmap_id != False or mrp_state == 'done'"/>
                <field name="mip_quantity" optional="hide" readonly="roadmap_id != False or mrp_state == 'done'"/>

                <field name="lot_size" optional="show"/>
                <field name="quantity" readonly="roadmap_id != False or mrp_state == 'done'"/>
                <field name="expected_final_quantity"/>
                <field name="quantity_estimation" optional="hide"/>
                <field name="virtual_available" optional="hide"/>
                <field name="no_manufacturing" optional="hide"/>
                <button name="action_create_roadmap_wizard" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="roadmap_id != False or mrp_state == 'done'"/>
                <button name="action_view_quantity_by_week" type="object" class="oe_stat_button"
                        icon="oi-view-pivot"/>
            </tree>
        </field>
    </record>

    <record id="view_mrp_plan_weekly_tree" model="ir.ui.view">
        <field name="name">product.mrp.plan.weekly.tree.inherit</field>
        <field name="model">product.mrp.plan.weekly</field>
        <field name="inherit_id" ref="dw_mrp_plan.view_mrp_plan_months_form"/>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_quantity_by_week']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_plan_tree" model="ir.ui.view">
        <field name="name">mrp.plan.tree</field>
        <field name="model">mrp.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="season_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="mrp_plan_action" model="ir.actions.act_window">
        <field name="name">Mrp Plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Mrp Plan.
            </p>
        </field>
    </record>

</odoo>