<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_roadmap_wizard_form" model="ir.ui.view">
        <field name="name">roadmap.wizard.form</field>
        <field name="model">roadmap.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="plan_line_id" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="bom_id" readonly="1"/>
                            <field name="bom_quantity" readonly="1"/>
                            <field name="lot_id" context="{'default_product_id': product_id,
                            'default_company_id': company_id, 'default_product_qty': bom_quantity}"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_validate" string="Validate" class="oe_highlight" type="object"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>