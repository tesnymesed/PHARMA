<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mrp_targets_form" model="ir.ui.view">
        <field name="name">dw.mrp.production.target.form</field>
        <field name="model">dw.mrp.production.target</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                            type="object"
                            name="action_approve"
                            string="Approve"
                            class="oe_highlight"
                            invisible="state in ('approved', 'done', 'cancelled')"
                    />
                    <button
                            type="object"
                            name="action_reject"
                            string="Reject"
                            class="oe_highlight"
                            invisible="state in ('rejected', 'done', 'cancelled')"
                    />
                    <button
                            type="object"
                            name="action_done"
                            string="Mark as Done"
                            class="oe_highlight"
                            invisible="state in ('draft', 'done', 'cancelled')"
                    />
                    <!--                    <button name="action_draft" invisible="state != 'cancelled'" string="Set to
                              Draft" type="object"/>-->
                    <button
                            name="action_cancel"
                            invisible="state not in ('draft', 'approved')"
                            string="Cancel"
                            type="object"
                    />

                    <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="draft,approved,done"
                    />
                </header>
                <group>
                    <div class="oe_edit_only">
                        <label for="name"/>
                    </div>
                    <h1>
                        <field name="name"/>
                    </h1>
                </group>
                <group>
                    <div class="oe_edit_only">
                        <label for="company_id"/>
                    </div>
                    <h1>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </h1>

                </group>
                <!--                    <group name="season_date_grp">-->
                <!--                        <field name="season_date" widget="yearPicker" invisible="1"/>-->
                <!--                    </group>-->

                <group>
                    <group>
                        <field name="start_date" required="1"/>
                    </group>
                    <group>
                        <field name="end_date" required="1"/>
                    </group>
                </group>


                <notebook>
                    <page name="product_target_lines" string="Products Targets">
                        <field name="product_target_ids">
                            <tree editable="bottom">
                                <field name="company_id" column_invisible="1"/>
                                <field name="product_id" required="1"/>
                                <field name="uom_id" optional="hide"/>
                                <field name="production_objective_qty"/>
                                <field name="sales_objective_qty"/>
                                <button
                                        name="action_view_product_monthly_targets"
                                        type="object"
                                        class="oe_stat_button"
                                        title="Monthly"
                                        icon="fa-calendar"
                                />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="view_dw_mrp_product_monthly_targets_tree" model="ir.ui.view">
        <field name="name">dw.mrp.product.monthly.target.tree</field>
        <field name="model">dw.mrp.product.monthly.target</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0">
                <field name="company_id" column_invisible="1"/>
                <field name="target_id" column_invisible="1"/>
                <field name="product_target_id" column_invisible="1"/>

                <field name="date" readonly="1" force_save="1"/>
                <field name="product_id" readonly="1" force_save="1" optional="hide"/>

                <field name="production_objective_qty" readonly="state == 'approved'"/>
                <field name="sales_objective_qty" readonly="state == 'approved'"/>

                <button
                        name="action_approve"
                        string="Approve"
                        invisible="state in ['approved', 'done']"
                        type="object"
                        icon="fa-check"
                />
                <button
                        name="action_reject"
                        string="Reject"
                        invisible="state in ['rejected', 'done']"
                        type="object"
                        icon="fa-times"
                />

                <field name="state" optional="hide" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="view_dw_mrp_product_monthly_targets_tree2" model="ir.ui.view">
        <field name="name">dw.mrp.product.monthly.target.tree2</field>
        <field name="model">dw.mrp.product.monthly.target</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="target_id"/>
                <field name="product_target_id"/>
                <field name="company_id"/>
                <field name="product_id" readonly="1" force_save="1" optional="hide"/>
                <field name="date" readonly="1" force_save="1"/>

                <field name="production_objective_qty" readonly="state == 'approved'"/>
                <field name="sales_objective_qty" readonly="state == 'approved'"/>
                <field name="state" optional="hide" readonly="1"/>

            </tree>
        </field>
    </record>

    <record id="dw_mrp_product_target_id_view_search" model="ir.ui.view">
        <field name="name">dw.mrp.product.monthly.target.view.search</field>
        <field name="model">dw.mrp.product.monthly.target</field>
        <field name="arch" type="xml">
            <search string="Search Targets">
                <group expand="0" string="Group By">
                    <filter
                            string="Company"
                            name="company"
                            domain="[]"
                            context="{'group_by': 'company_id'}"
                    />
                    <filter
                            string="Production Targets"
                            name="targets"
                            domain="[]"
                            context="{'group_by': 'target_id'}"
                    />
                    <filter
                            string="Products Targets"
                            name="product_target_id"
                            domain="[]"
                            context="{'group_by': 'product_target_id'}"
                    />
                    <filter
                            string="Product"
                            name="product"
                            domain="[]"
                            context="{'group_by': 'product_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_dw_mrp_product_target_id_form" model="ir.ui.view">
        <field name="name">dw.mrp.product.monthly.target.form</field>
        <field name="model">dw.mrp.product.monthly.target</field>
        <field name="arch" type="xml">
            <form string="Products Targets">
                <header>
                    <button
                            string="Approve"
                            type="object"
                            name="action_approve"
                            class="oe_highlight"
                            invisible="state in ('approved', 'done', 'cancelled')"
                    />
                    <button
                            string="Reject"
                            type="object"
                            name="action_reject"
                            class="oe_highlight"
                            invisible="state in ('rejected', 'done', 'cancelled')"
                    />
                    <button
                            string="Mark as Done"
                            type="object"
                            name="action_done"
                            class="oe_highlight"
                            invisible="not state == 'approved' and state == 'done'"
                    />
                    <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            invisible="state == 'done'"
                    />

                    <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="draft,done"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="date"/>
                        <field name="state" readonly="1"/>
                    </group>
                    <group>
                        <field name="production_objective_qty"/>
                        <field name="sales_objective_qty"/>
                    </group>
                    <group>
                        <field name="product_target_id" readonly="1"/>
                        <field name="target_id" readonly="1"/>
                        <field name="company_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="uom_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dw_mrp_production_targets_tree" model="ir.ui.view">
        <field name="name">dw.mrp.production.target.tree</field>
        <field name="model">dw.mrp.production.target</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="dw_mrp_production_targets_action" model="ir.actions.act_window">
        <field name="name">MRP Production Targets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dw.mrp.production.target</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create new MRP Production Targets.</p>
        </field>
    </record>

    <record id="dw_mrp_product_monthly_target_items" model="ir.actions.act_window">
        <field name="name">MRP Products Monthly Target Items</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dw.mrp.product.monthly.target</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_dw_mrp_product_monthly_targets_tree2"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new MRP Products Targets.
            </p>
        </field>
    </record>

</odoo>
