<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Client action  -->
    <record id="action_mrp_product_supply_plan" model="ir.actions.client">
        <field name="name">Product Supply Plan</field>
        <field name="tag">mrp_product_supply_plan</field>
        <field name="target">new</field>
    </record>

    <record id="view_mrp_supply_plan_form" model="ir.ui.view">
        <field name="name">dw.mrp.supply.plan.form</field>
        <field name="model">dw.mrp.supply.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Monthly Product QTY" name="run_action" type="object"/>
                    <button type="object" name="action_done" string="Mark as Done" class="oe_highlight"
                            invisible="state == 'done'"/>
                    <!--                    <button name="action_import_excel_view" string="Import Excel" type="object"/>-->
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
<!--                <div class="oe_button_box" name="button_box">-->
<!--                    <button-->
<!--                            type="object"-->
<!--                            name="action_print"-->
<!--                            class="oe_stat_button"-->
<!--                            icon="fa-folder-open-o"-->
<!--                            string="Overview"-->
<!--                    />-->
<!--                    <button-->
<!--                            type="object"-->
<!--                            name="action_display_all_roadmaps"-->
<!--                            class="oe_stat_button"-->
<!--                            icon="fa-sitemap"-->
<!--                            string="Roadmaps"-->
<!--                    />-->
<!--                </div>-->
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group name="season_date_grp">
                        <field name="season_date" widget="yearPicker" required="1"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>

                <notebook>
                    <page name="product_plan" string="Product Supply Plan">
                        <field name="product_supply_plan_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="product_id" required="1"/>
                                <field name="uom_id" optional="hide"/>
                                <button name="action_view_product_monthly_supply_plan" type="object" class="oe_stat_button"
                                        icon="fa-list"/>
                                <button name="print_plan_summary_report" type="object" icon="fa-desktop"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="view_dw_mrp_product_monthly_supply_plan_form" model="ir.ui.view">
        <field name="name">dw.mrp.product.supply.plan.tree</field>
        <field name="model">dw.mrp.product.supply.plan</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0">
                <field name="product_supply_plan_id" column_invisible="1"/>
                <field name="date" readonly="1" force_save="1"/>
                <field name="product_id" readonly="1" force_save="1"/>

                <field name="quantity_planned"/>
                <field name="quantity_approved" optional="show" readonly="state == 'approved'"/>
                <field name="quantity_to_order" optional="hide" readonly="state == 'approved'"/>
                <field name="quantity_done" optional="show" readonly="state == 'approved'"/>


                <field name="state" optional="hide" readonly="1"/>

                <field name="date_launch" optional="hide" readonly="1" force_save="1"/>

            </tree>
        </field>
    </record>

    <record id="view_mrp_supply_plan_tree" model="ir.ui.view">
        <field name="name">dw.mrp.supply.plan.tree</field>
        <field name="model">dw.mrp.supply.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="season_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="mrp_supply_plan_action" model="ir.actions.act_window">
        <field name="name">MRP Supply Plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dw.mrp.supply.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new MRP Supply Plan.
            </p>
        </field>
    </record>

</odoo>