<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_dw_payment_request_tree" model="ir.ui.view">
            <field name="name">dw.payment.request.tree</field>
            <field name="model">dw.payment.request</field>
            <field name="arch" type="xml">
                <tree
                        decoration-success="state == 'confirm'" decoration-danger="state == 'rejected'">

                    <field name="name" optional="show"/>
                    <field name="state" optional="show"/>
                    <field name="user_id" optional="hide"/>
                    <field name="confirmed_by_id" optional="show"/>
                    <field name="request_date" optional="show"/>
                    <field name="date_limit" optional="show"/>
                    <field name="validation_date" optional="show"/>
                    <field name="payment_request_type" optional="show"/>
                    <field name="journal_id" optional="show"/>

                </tree>
            </field>
        </record>


        <record id="view_dw_payment_request" model="ir.ui.view">
            <field name="name">dw.payment.request.view</field>
            <field name="model">dw.payment.request</field>
            <field name="arch" type="xml">
                <form string="approval">
                    <header>
                        <button name="action_confirm" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'draft' "
                                type="object"/>
                        <button name="action_reject" string="reject"
                                class="btn-primary"
                                invisible="state != 'confirm' "
                                type="object"/>
                        <button name="action_cancel" string="Cancel"
                                class="btn-primary"
                                invisible="state in ['draft','cancelled'] "
                                type="object"/>
                        <button name="action_to_draft" string="return to draft"
                                class="btn-primary"
                                invisible="state != 'cancelled' "
                                type="object"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirm"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <div>
                                <label for="name"/>
                            </div>
                            <h1 class="mb32">
                                <field name="name" placeholder="e.g. Form .." class="mb16"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="request_date"/>
                                <field name="date_limit"/>
                                <field name="validation_date"/>
                                <field name="amount_in_text" invisible="1"/>

                            </group>
                            <group>
                                <field name="confirmed_by_id"/>
                                <field name="payment_request_type"/>
                                <field name="journal_id"/>
                                <field name="date" invisible="state != 'rejected'"/>
                                <field name="reject_motif_id" invisible="state != 'rejected'"/>
                                <field name="dw_account_move_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="check_num"/>
                                <field name="Payment_order"/>
                                <field name="montant" widget="monetary"/>
                                <field name="request_type" string="Payment Request Type"/>
                            </group>

                        </group>

                    </sheet>

                </form>
            </field>
        </record>

    </data>

</odoo>