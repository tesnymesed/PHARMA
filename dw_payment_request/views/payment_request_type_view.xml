<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_payment_request_type_form" model="ir.ui.view">
            <field name="name">payment.request.type.form</field>
            <field name="model">payment.request.type</field>
            <field name="arch" type="xml">
                <form string="Payment Request Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_payment_request_type_tree" model="ir.ui.view">
            <field name="name">payment.request.type.tree</field>
            <field name="model">payment.request.type</field>
            <field name="arch" type="xml">
                <tree string="Payment Request Types">
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_payment_request_type" model="ir.actions.act_window">
            <field name="name">Payment Request Types</field>
            <field name="res_model">payment.request.type</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
