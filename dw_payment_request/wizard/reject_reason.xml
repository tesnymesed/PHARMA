<?xml version="1.0" encoding="UTF-8" ?>
<odoo>



    <record id="dw_reject_reason_form" model="ir.ui.view">
        <field name="name">dw.reject.reason.wizard.form</field>
        <field name="model">dw.reject.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Reason">
                <group>
                    <group><field name="date" required="true" /></group>
                    <group>  </group>
                    <field name="payment_request_id" invisible="1"/>


                </group>
                <group>  <field name="reject_motif_id" required="true" options="{'no_create': True}" /></group>
                <footer>
                    <button name="action_confirm" string="Submit" type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>




</odoo>