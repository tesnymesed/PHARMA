<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_supplier_approval" model="ir.actions.act_window">
            <field name="name">Market</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">procurement.market.dw</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('for_approval','=',False)]</field>
            <field name="context">{'default_for_approval':False}</field>

        </record>

        <record id="action_market_type" model="ir.actions.act_window">
            <field name="name">Market</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">procurement.market.dw.type</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>

        </record>
        <record id="action_view_article_market" model="ir.actions.act_window">
            <field name="name">Article</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('purchase_ok', '=', True)]
            </field>
        </record>
        <menuitem id="menu_supplier_approval_root"
                  name="Procurement"
                  web_icon="dw_procurement,static/description/icon.png"
                  groups="dw_procurement.group_user_procurement"

                  sequence="10"

        />
        <menuitem id="menu_supplier_approval_configuration"
                  name="Configuration"
                  sequence="20"
                  groups="dw_procurement.group_manager_procurement"
                  parent="dw_procurement.menu_supplier_approval_root"

        />
        <menuitem id="menu_market_type"
                  name="Market Type"
                  parent="dw_procurement.menu_supplier_approval_configuration"
                  action="action_market_type"
                  sequence="20"

        />
        <menuitem id="menu_market_products"
                  name="Products"
                  parent="dw_procurement.menu_supplier_approval_configuration"
                  action="dw_procurement.action_view_article_market"
                  sequence="20"

        />
        <menuitem id="menu_market_root"
                  name="Market"
                  parent="menu_supplier_approval_root"
                  sequence="10"
        />


        <menuitem id="menu_market"
                  name="Market"
                  parent="menu_market_root"
                  action="action_supplier_approval"
                  sequence="10"
        />


        <menuitem name="Consultation" id="dw_consultation_menu" parent="menu_supplier_approval_root"
                  action="dw_consultation_act_window" sequence="15"/>
        <menuitem name="Consultation Criteria" id="dw_consultation_criteria_menu"
                  parent="menu_supplier_approval_configuration"
                  action="dw_consultation_criteria_act_window"
                  sequence="20"
        />

        <menuitem id="menu_procurement_reject_cancel_reason" name="Procurement Reasons"
                  parent="dw_procurement.menu_supplier_approval_configuration"
                  sequence="10"/>

        <menuitem id="submenu_procurement_reject_cancel_reason"
                  name="Reasons for Procurement Reject/Cancel"
                  parent="dw_procurement.menu_procurement_reject_cancel_reason"
                  action="action_procurement_reject_cancel_reason"/>
    </data>
</odoo>