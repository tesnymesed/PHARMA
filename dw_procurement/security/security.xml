<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="procurement_category" model="ir.module.category">
            <field name="name">Procurement</field>
            <field name="sequence">11</field>
        </record>

        <record id="group_user_procurement" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="dw_procurement.procurement_category"/>
        </record>
        <record id="group_manager_procurement" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="dw_procurement.procurement_category"/>
            <field name="implied_ids" eval="[(4, ref('dw_procurement.group_user_procurement'))]"/>

        </record>
        <record id="ir_rule_dw_market_multi_company" model="ir.rule">
            <field name="name">Dw Market: Multi Company</field>
            <field name="model_id" ref="model_procurement_market_dw"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>


    </data>
</odoo>