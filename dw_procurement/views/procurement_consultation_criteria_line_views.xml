<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="dw_consultation_criteria_tree_view" model="ir.ui.view">
            <field name="name">dw_supplier_approval.dw_consultation_criteria.tree</field>
            <field name="model">procurement.dw.consultation.criteria.line</field>
            <field name="arch" type="xml">
                <tree string="Consultation Criteria" expand="1" >
                    <header>
                        <button name="generate_xlsx_report" string="TCO" type="object" class="oe_highlight" invisible ="1"/>
                    </header>
                    <field name="criteria_id"/>
                    <field name="supplier_id"/>
                    <field name="dw_supplier_nature"/>
                    <field name="product_id"/>
                    <field name="amount"/>
                    <field name="percentage"/>
                    <field name="number_days"/>
                    <field name="completed"/>
                    <field name="observation"/>
                </tree>
            </field>
        </record>

        <record id="dw_consultation_criteria_search_view" model="ir.ui.view">
            <field name="name">dw_supplier_approval.dw_consultation_criteria.search</field>
            <field name="model">procurement.dw.consultation.criteria.line</field>
            <field name="arch" type="xml">
                <search string="Consultation Criteria">
                    <field name="name" string="Criteria"/>
                    <field name="criteria_type" string="Type"/>
                    <group expand="1" string="Group By">

                        <filter string="Product" name="product_grp" domain="[]"
                                context="{'group_by':'product_id'}"/>
                        <filter string="Criteria" name="criteria_grp" domain="[]"
                                context="{'group_by':'criteria_id'}"/>
                        <filter string="Supplier" name="supplier_grp" domain="[]"
                                context="{'group_by':'supplier_id'}"/>

                    </group>
                    <separator/>
                </search>
            </field>
        </record>


    </data>
</odoo>