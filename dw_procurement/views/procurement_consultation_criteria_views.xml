<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="dw_consultation_criteria_form_view" model="ir.ui.view">
            <field name="name">dw_supplier_approval.dw_consultation_criteria.form</field>
            <field name="model">procurement.dw.consultation.criteria</field>
            <field name="arch" type="xml">
                <form string="Consultation Criteria">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="criteria_type" required="1"/>
                                <field name="type" required="1"/>
<!--                                <field name="period_type" invisible="criteria_type != 'period'"-->
<!--                                       required="criteria_type == 'period'"/>-->
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="dw_consultation_criteria_tree_view" model="ir.ui.view">
            <field name="name">dw_supplier_approval.dw_consultation_criteria.tree</field>
            <field name="model">procurement.dw.consultation.criteria</field>
            <field name="arch" type="xml">
                <tree string="Consultation Criteria">
                    <field name="name"/>
                    <field name="criteria_type"/>
                    <field name="period_type"/>
                </tree>
            </field>
        </record>

        <record id="dw_consultation_criteria_search_view" model="ir.ui.view">
            <field name="name">dw_supplier_approval.dw_consultation_criteria.search</field>
            <field name="model">procurement.dw.consultation.criteria</field>
            <field name="arch" type="xml">
                <search string="Consultation Criteria">
                    <field name="name" string="Criteria"/>
                    <field name="criteria_type" string="Type"/>
                    <group expand="1" string="Group By">
                        <filter string="Criteria Type" name="criteria_type_grp" domain="[]"
                                context="{'group_by':'criteria_type'}"/>
                    </group>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="dw_consultation_criteria_act_window" model="ir.actions.act_window">
            <field name="name">Consultation Criteria</field>
            <field name="res_model">procurement.dw.consultation.criteria</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'active_test': False}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Consultation Criteria.
                </p>
            </field>
        </record>


    </data>
</odoo>