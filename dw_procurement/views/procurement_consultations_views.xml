<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="dw_consultation_form_view" model="ir.ui.view">
            <field name="name">dw_supplier_approval.dw_consultation.form</field>
            <field name="model">procurement.dw.consultation</field>
            <field name="arch" type="xml">
                <form string="Consultation">
                    <header>

                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,consulted,allocated"/>
                        <button name="action_draft" string="Mark as Draft" type="object" class="btn-primary"
                                invisible="state not in ['canceled']"/>
                        <button name="action_consulted" string="Mark as Consulted" type="object" class="btn-primary"
                                invisible="state not in ['draft']"/>

                        <button name="action_reject" string="Reject" type="object" class="btn-primary"
                                invisible="state in ['allocated','canceled','reject']"/>
                        <button name="action_canceled" string="Cancel" type="object" class="btn-primary"
                                invisible="state in ['allocated','canceled']"/>

                    </header>

                    <sheet>
                        <widget name="web_ribbon" title="Attribué" bg_color="text-bg-success"
                                invisible="state not in 'allocated'"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_show_market" type="object" class="oe_stat_button"
                                    icon="fa-list-alt" invisible=" not market_id">
                                <div class="o_stat_info">

                                    <span class="o_stat_text">Market</span>
                                </div>
                            </button>

                            <button name="action_show_Attribution" type="object"
                                    class="oe_stat_button"
                                    invisible="state not in ['allocated'] "
                                    icon="fa-list-alt">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Attribution</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="for_approval" invisible="1"/>
                                <field name="supplier_id"/>

                                <field name="dw_supplier_nature" readonly="market_id and for_approval "/>

                                <field name="product_id"/>
                                <field name="user_id"/>
                                <field name="dw_manufacturer" readonly="state == 'approval'" invisible="dw_supplier_nature == 'fabricant'" required="dw_supplier_nature == 'regroupeur'"/>


                            </group>
                            <group>
                                <field name="start_date" required="1" readonly="state != 'draft'"/>
                                <field name="end_date" required="1" readonly="0"/>
                                <field name="market_id" invisible="1"/>

                                <field name="active"/>
                                <field name="company_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="consultation_criteria" string="Supplier Offer">
                                <field name="criteria_line_ids" mode="tree" nolabel="1" invisible="not market_id" >
                                    <tree string="Criteria Consultation" multi_edit="1" duplicate="false" create="0"
                                          editable="bottom">
                                        <field name="criteria_type" column_invisible="1"/>
                                        <field name="period_type" column_invisible="1"/>
                                        <field name="criteria_id" readonly="1" domain="[('type', '=', 'supplier_offer')]"/>
                                        <field name="amount" readonly="criteria_type  not in ['amount', 'monetary']"
                                               required="criteria_type  in ['amount', 'monetary']"/>
                                        <field name="percentage" readonly="criteria_type  != 'percentage'"
                                               required="criteria_type  == 'percentage'"/>
                                        <field name="number_days"
                                               readonly="criteria_type  != 'period' or period_type != 'days' "
                                               required="criteria_type  == 'period' and period_type == 'days' "/>
                                        <field name="completed" readonly="criteria_type  != 'boolean'"
                                               required="criteria_type  == 'boolean'"/>
                                        <field name="observation" readonly="criteria_type  != 'text'"
                                               required="criteria_type  == 'text'"/>
                                        <field name="currency_id" readonly="criteria_type  != 'monetary'"
                                               required="criteria_type  == 'monetary'"/>
                                        <field name="incoterm_id" readonly="criteria_type  != 'monetary'"
                                               required="criteria_type  == 'monetary'"/>
                                        <field name="type" column_invisible="1"/>

                                        <!--                                        <field name="number_months"-->
                                        <!--                                               readonly="criteria_type  != 'period' or period_type != 'months' "-->
                                        <!--                                               required="criteria_type  == 'period' and period_type == 'months' "/>-->
                                        <!--                                        <field name="number_years"-->
                                        <!--                                               readonly="criteria_type  != 'period' or period_type != 'years' "-->
                                        <!--                                               required="criteria_type  == 'period' and period_type == 'years' "/>-->
                                    </tree>
                                </field>
                                <field name="criteria_line_ids" mode="tree" nolabel="1" invisible="market_id" >
                                    <tree string="Criteria Consultation" multi_edit="1" duplicate="false" create="1"
                                          editable="bottom">
                                        <field name="criteria_type" column_invisible="1"/>
                                        <field name="period_type" column_invisible="1"/>
                                        <field name="criteria_id" domain="[('type', '=', 'supplier_offer')]"/>
                                        <field name="amount" readonly="criteria_type  not in ['amount', 'monetary']"
                                               required="criteria_type in ['amount', 'monetary']"/>
                                        <field name="percentage" readonly="criteria_type  != 'percentage'"
                                               required="criteria_type  == 'percentage'"/>
                                        <field name="number_days"
                                               readonly="criteria_type  != 'period' or period_type != 'days' "
                                               required="criteria_type  == 'period' and period_type == 'days' "/>
                                        <field name="completed" readonly="criteria_type  != 'boolean'"
                                               required="criteria_type  == 'boolean'"/>
                                        <field name="currency_id" readonly="criteria_type  != 'monetary'"
                                               required="criteria_type  == 'monetary'"/>
                                        <field name="incoterm_id" readonly="criteria_type  != 'monetary'"
                                               required="criteria_type  == 'monetary'"/>
                                        <field name="type" column_invisible="1"/>

                                        <!--                                        <field name="number_months"-->
                                        <!--                                               readonly="criteria_type  != 'period' or period_type != 'months' "-->
                                        <!--                                               required="criteria_type  == 'period' and period_type == 'months' "/>-->
                                        <!--                                        <field name="number_years"-->
                                        <!--                                               readonly="criteria_type  != 'period' or period_type != 'years' "-->
                                        <!--                                               required="criteria_type  == 'period' and period_type == 'years' "/>-->
                                    </tree>
                                </field>
                            </page>
                            <page name="consultation_criteria" string="TCO Criteria ">
                                <field name="criteria_line_ids" mode="tree" nolabel="1" invisible="not market_id" >
                                    <tree string="Criteria Consultation" multi_edit="1" duplicate="false" create="0"
                                          editable="bottom">
                                        <field name="criteria_type" column_invisible="1"/>
                                        <field name="period_type" column_invisible="1"/>
                                        <field name="criteria_id" readonly="1" domain="[('type', '=', 'criteria_tco')]"/>
                                        <field name="amount" readonly="criteria_type  not in ['amount', 'monetary']"
                                               required="criteria_type  in ['amount', 'monetary']"/>
                                        <field name="percentage" readonly="criteria_type  != 'percentage'"
                                               required="criteria_type  == 'percentage'"/>
                                        <field name="number_days"
                                               readonly="criteria_type  != 'period' or period_type != 'days' "
                                               required="criteria_type  == 'period' and period_type == 'days' "/>
                                        <field name="completed" readonly="criteria_type  != 'boolean'"
                                               required="criteria_type  == 'boolean'"/>
                                        <field name="observation" readonly="criteria_type  != 'text'"
                                               required="criteria_type  == 'text'"/>
                                        <field name="currency_id" readonly="criteria_type  != 'monetary'"
                                               required="criteria_type  == 'monetary'"/>
                                        <field name="incoterm_id" readonly="criteria_type  != 'monetary'"
                                               required="criteria_type  == 'monetary'"/>
                                        <field name="type" column_invisible="1"/>

                                        <!--                                        <field name="number_months"-->
                                        <!--                                               readonly="criteria_type  != 'period' or period_type != 'months' "-->
                                        <!--                                               required="criteria_type  == 'period' and period_type == 'months' "/>-->
                                        <!--                                        <field name="number_years"-->
                                        <!--                                               readonly="criteria_type  != 'period' or period_type != 'years' "-->
                                        <!--                                               required="criteria_type  == 'period' and period_type == 'years' "/>-->
                                    </tree>
                                </field>
                                <field name="criteria_line_ids" mode="tree" nolabel="1" invisible="market_id" >
                                    <tree string="Criteria Consultation" multi_edit="1" duplicate="false" create="1"
                                          editable="bottom">
                                        <field name="criteria_type" column_invisible="1"/>
                                        <field name="period_type" column_invisible="1"/>
                                        <field name="criteria_id" domain="[('type', '=', 'criteria_tco')]"/>
                                        <field name="amount" readonly="criteria_type  not in ['amount', 'monetary']"
                                               required="criteria_type in ['amount', 'monetary']"/>
                                        <field name="percentage" readonly="criteria_type  != 'percentage'"
                                               required="criteria_type  == 'percentage'"/>
                                        <field name="number_days"
                                               readonly="criteria_type  != 'period' or period_type != 'days' "
                                               required="criteria_type  == 'period' and period_type == 'days' "/>
                                        <field name="completed" readonly="criteria_type  != 'boolean'"
                                               required="criteria_type  == 'boolean'"/>
                                        <field name="currency_id" readonly="criteria_type  != 'monetary'"
                                               required="criteria_type  == 'monetary'"/>
                                        <field name="incoterm_id" readonly="criteria_type  != 'monetary'"
                                               required="criteria_type  == 'monetary'"/>
                                        <field name="type" column_invisible="1"/>

                                        <!--                                        <field name="number_months"-->
                                        <!--                                               readonly="criteria_type  != 'period' or period_type != 'months' "-->
                                        <!--                                               required="criteria_type  == 'period' and period_type == 'months' "/>-->
                                        <!--                                        <field name="number_years"-->
                                        <!--                                               readonly="criteria_type  != 'period' or period_type != 'years' "-->
                                        <!--                                               required="criteria_type  == 'period' and period_type == 'years' "/>-->
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="dw_consultation_tree_view" model="ir.ui.view">
            <field name="name">dw_supplier_approval.dw_consultation.tree</field>
            <field name="model">procurement.dw.consultation</field>
            <field name="arch" type="xml">
                <tree string="Consultation" decoration-info="state == 'consulted'"
                      decoration-success="state == 'allocated'"
                      decoration-danger="state != 'allocated' and end_date > context_today().strftime('%Y-%m-%d')">

                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="product_id"/>
                    <field name="start_date" optional="show"/>
                    <field name="end_date" optional="show"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="dw_consultation_search_view" model="ir.ui.view">
            <field name="name">dw_supplier_approval.dw_consultation.search</field>
            <field name="model">procurement.dw.consultation</field>
            <field name="arch" type="xml">
                <search string="Consultation">
                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="product_id"/>
                    <group expand="1" string="Group By">
                        <filter string="Supplier" name="supplier_id" domain="[]"
                                context="{'group_by':'supplier_id'}"/>
                        <filter string="*product" name="product_id" domain="[]"
                                context="{'group_by':'product_id'}"/>
                    </group>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="dw_consultation_act_window" model="ir.actions.act_window">
            <field name="name">Consultation</field>
            <field name="res_model">procurement.dw.consultation</field>
            <field name="context">{'active_test': False}</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new Consultation.
                </p>
            </field>
        </record>
        <record id="dw_consultation_form_view_canceled" model="ir.ui.view">
            <field name="name">procurement.dw.consultation.motif</field>
            <field name="model">procurement.dw.consultation</field>
            <field name="arch" type="xml">
                <form string="Consultation Motif">
                    <sheet>

                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                            </group>
                            <group>
                                <field name="canceled_motif_id" required="context.get('dw_consultation_cancel_reason')"
                                       invisible="not context.get('dw_consultation_cancel_reason')"/>
                                <field name="reject_motif_id" required="context.get('dw_consultation_reject_reason')"
                                       invisible="not context.get('dw_consultation_reject_reason')"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="button_canceled" string="Cancel" type="object" class="btn-primary"
                                invisible="not context.get('dw_consultation_cancel_reason')"/>
                        <button name="button_reject" string="Reject" type="object" class="btn-primary"
                                invisible="not context.get('dw_consultation_reject_reason')"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>

                    </footer>
                </form>
            </field>
        </record>


    </data>
</odoo>