<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_supplier_approval_tree" model="ir.ui.view">
            <field name="name">procurement.supplier.approval.tree</field>
            <field name="model">procurement.supplier.approval</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'approval'"
                      decoration-success="state == 'approval'" decoration-danger="state == 'approval' and end_date &lt; context_today().strftime('%Y-%m-%d')">

                    <header>
                        <!-- <button name="action_create_consultation" string="Lancer consultation" type="object"
                                class="btn-primary"/> -->
                    </header>
                    <field name="name" optional="show"/>
                    <field name="product_id" optional="hide"/>
                    <field name="supplier_id" optional="show"/>
                    <field name="dw_supplier_nature" optional="show"/>
                    <field name="start_date" optional="show"/>
                    <field name="end_date" optional="show"/>
<!--                     <field name="consultation_ids" column_invisible="1"/>
 -->                    <field name="market_ids" optional="hide"/>
                    <field name="state" optional="show"/>
                    <field name="lot_validation" optional="show"/>
                    <field name="company_id" optional="hide"/>
                    <!-- <button string="Consulter" name="action_create_consultation" type="object" icon="fa-check"
                            invisible="state != 'approval' or  consultation_ids"/> -->


                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="view_supplier_approval_form">
            <field name="name">procurement.supplier.approval.form</field>
            <field name="model">procurement.supplier.approval</field>

            <field name="arch" type="xml">
                <form string="supplier_approval">
                    <header>
                        <button name="button_prospecting" string="return to draft"
                                class="btn-primary"
                                invisible="state != 'cancel' "
                                type="object"/>
                        <button name="action_to_analyse" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'prospecting'"
                                type="object"/>
                        <button name="action_to_audit" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'analyse' or purchase_id == False"
                                type="object"/>
                        <button name="load_reports" string="Load reports"
                                class="btn-primary"
                                invisible="state != 'analyse'"
                                type="object"/>
                        <button name="action_load_Pre_eval_quest_file" string="load Pre-evaluation questionnaire"
                                class="btn-primary"
                                invisible="state != 'prospecting'"
                                type="object"/>
                        <button name="action_load_audit_report" string="load audit report"
                                class="btn-primary"
                                invisible="state != 'audit'"
                                type="object"/>
                        <button name="action_load_stabilite_file" string="load Stability Report"
                                class="btn-primary"
                                invisible="state != 'lot_validation'"
                                type="object"/>


                        <button name="action_to_lot_validation_or_qualification" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'audit'"
                                type="object"/>
                        <button name="action_to_qualification" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'lot_validation'"
                                type="object"/>

                        <button name="action_homologate" string="approval"
                                class="btn-primary"
                                invisible="state in ['cancel','rejected','prospecting','audit','lot_validation','approval']"
                                type="object"/>

                        <!-- <button name="create_purchase_order" string="Create Purchase order"
                                class="btn-primary"
                                invisible="state != 'analyse' or purchase_id != False"
                                type="object"/> -->
                        <!-- <button name="action_lunch_consultation" string="Lunch Consultation"
                                class="btn-primary"
                                invisible="state != 'approval' or consultation_ids "
                                type="object"/>
 -->
                        <button
                                name="action_cancel" string="Cancel"
                                type="object" class="btn-primary" data-hotkey="q"
                                invisible="state in ['prospecting','cancel','approval'] "
                        />
                      <!--   <button
                                name="market_assign" string="Assign market"
                                type="object" class="btn-primary" data-hotkey="q"
                                invisible="state in ['prospecting','cancel','qualification','rejected'] "
                        /> -->
                        <button
                                name="action_reject" string="Reject"
                                type="object" class="btn-primary" data-hotkey="q"
                                invisible="state in ['prospecting','qualification','rejected'] "
                        />

                        <field name="state" widget="statusbar"
                               statusbar_visible="prospecting,analyse,audit,lot_validation,qualification"/>
                        <!--                        rescind,cancel-->
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Consulted" bg_color="text-bg-success"
                                />

                        <div class="oe_button_box" name="button_box">
                            <!-- <button name="show_purchase_order" type="object" class="oe_stat_button"
                                    icon="fa-list-alt" invisible="purchase_id == False">
                                <div class="o_stat_info">

                                    <span class="o_stat_text">PO Sample</span>
                                </div>
                            </button> -->
                            <!-- <button name="action_show_market" type="object"
                                    class="oe_stat_button"
                                    invisible="not market_ids "
                                    icon="fa-list-alt">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Market</span>
                                </div>
                            </button> -->
                            <!-- <button name="action_show_consultations" type="object"
                                    class="oe_stat_button"
                                    invisible="state not in ['approval'] or not consultation_ids "
                                    icon="fa-list-alt">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Consultations</span>
                                </div>
                            </button> -->
                            <button name="show_documents" type="object" class="oe_stat_button"
                                    icon="fa-list-alt">
                                <div class="o_stat_info">

                                    <span class="o_stat_text">Documents</span>
                                </div>
                            </button>

                        </div>
                        <group>

                            <group>

                                <field name="market_supplier_ids" invisible="1"/>
<!--                                 <field name="consultation_ids" invisible="1"/>
 -->                                <field name="product_id" readonly="state != 'prospecting'" invisible="market_ids"/>
                                <field name="supplier_id" readonly="state != 'prospecting'" invisible="market_ids"/>
                                <field name="dw_supplier_nature" readonly="state == 'approval'" required="1"/>
                                <field name="dw_product_pharma_family_name" required="1" />
                                <field name="dw_manufacturer" readonly="state == 'approval'" invisible="dw_supplier_nature == 'fabricant'" required="dw_product_pharma_family_name=='PA' and dw_supplier_nature == 'regroupeur'"/>
                                <label for="street"/>
                                <div>
                                    <field name="street" placeholder="Street..." readonly="state == 'approval'"
                                           required="1" class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." readonly="state == 'approval'"
                                           required="1" class="o_address_street"/>
                                    <field name="city" placeholder="City" readonly="state == 'approval'" required="1"
                                           class="o_address_city"/>
                                    <div class="o_row">
                                        <field name="state_id" creadonly="state == 'approval'" required="1"
                                               class="o_address_state" placeholder="State"
                                               options="{'no_open': True, 'no_quick_create': True}"
                                               context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                        <field name="zip" placeholder="ZIP" readonly="state == 'approval'" required="0"
                                               class="o_address_zip"/>
                                    </div>
                                    <field name="country_id" placeholder="Country" class="o_address_country"
                                           readonly="state == 'approval'" required="1"/>
                                </div>


                            </group>
                            <group>
                                <field name="start_date" required="1" readonly="state != 'draft'"/>
                                <field name="end_date" required="1" readonly="0"/>
                                <field name="market_ids" invisible="1"/>
                                <field name="product_ids" invisible="1"/>
                                <field name="company_id" readonly="state != 'prospecting'"/>
                                <field name="lot_validation" readonly="state not in ['analyse','prospecting','audit']"/>
                                <field name="phone" widget="phone" required="1" readonly="state == 'approval'"/>
                                <field name="email" widget="email" required="1" readonly="state == 'approval'"/>
                                <field name="purchase_id" invisible="1"/>
                            </group>
                        </group>


                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_supplier_approval_list">
            <field name="name">approval</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">procurement.supplier.approval</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree' , 'view_id': ref('dw_supplier_approval.view_supplier_approval_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dw_supplier_approval.view_supplier_approval_form')})]"/>
            <field name="domain">[('market_ids','in',active_id)]</field>
            <field name="context">{
                "default_market_ids":[Command.link(active_id)],
                }
            </field>
        </record>


    </data>
</odoo>

