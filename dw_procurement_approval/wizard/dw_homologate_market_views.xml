        <record id="dw_procurement_market_supplier_wizard_tree_view" model="ir.ui.view">
            <field name="name">Market Approval</field>
            <field name="model">procurement.approval.market.wizard</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree multi_edit="1" create="0">

                    <field name="market_id" invisible="0"/>

                    <field name="company_id" column_invisible="1"/>
                    <field name="supplier_id"/>
                    <field name="product_id"/>
                    <field name="approval_id"/>
                    <button name="action_link_approval_to_market" type="object"
                            invisible="not approval_id"
                            class="btn btn-link text-info" icon="fa-link"
                            string="Link to market"/>
                    <button name="action_confirm_create_approval" type="object"
                            invisible="approval_id"
                            class="btn btn-link text-success" icon="fa-plus-circle"
                            string="create approval"/>
                    <header>
                        <button name="action_link_all_approval_to_market" string="Link approval" class="oe_highlight" type="object"/>
                        <button name="action_confirm_all_create_approval" string="Create approval" class="oe_highlight" type="object"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </header>
                </tree>

            </field>
        </record>

    </data>
</odoo>