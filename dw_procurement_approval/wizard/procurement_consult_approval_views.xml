<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

                <record id="approval_consult_form_view" model="ir.ui.view">
                    <field name="name">Approval Market Consult</field>
                    <field name="model">procurement.consult.approval</field>
                    <field name="type">form</field>
                    <field name="arch" type="xml">
                        <form>
                            <sheet>
                                <group>

                                    <field name="approval_id" invisible="1"/>
                                    <field name="market_id"/>
                                    <field name="company_id" invisible="1"/>
                                </group>
                                <footer>

                                    <button
                                            name="action_create_consultation"
                                            string="Submit consult"
                                            type="object" invisible="not market_id"
                                            class="btn-primary"/>
                                    <button special="cancel" string="Cancel" class="oe_link"/>
                                </footer>
                            </sheet>
                        </form>
                    </field>
                </record>


    </data>
</odoo>