<?xml version="1.0"?>
<odoo>
    <record id="product_template_pharma_form_view" model="ir.ui.view">
        <field name="name">product.template.pharma.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group>
                    <field name="dw_product_class_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>