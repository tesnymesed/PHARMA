<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_allowed_quotas_button_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!--            <xpath name="//button_box" position="inside">-->
                <!--            <xpath expr="//button[@name='action_open_product_lot']" position="after">-->
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_allowed_quotas" type="object"
                            class="oe_stat_button"
                            icon="fa-bar-chart"
                            invisible="not purchase_ok">
                        <div class="o_field_widget o_stat_info">
                            <!--                            <span class="o_stat_value">-->
                            <!--                                <t t-esc="record.allowed_quotas_count"/>-->
                            <!--                            </span>-->
                            <span class="o_stat_text">Allowed Quotas</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_allowed_quotas_button_view_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!--            <xpath name="//button_box" position="inside">-->
                <!--            <xpath expr="//button[@name='action_open_product_lot']" position="after">-->
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_allowed_quotas" type="object"
                            class="oe_stat_button"
                            icon="fa-bar-chart"
                            invisible="not purchase_ok">
                        <div class="o_field_widget o_stat_info">
                            <!--                            <span class="o_stat_value">-->
                            <!--                                <t t-esc="record.allowed_quotas_count"/>-->
                            <!--                            </span>-->
                            <span class="o_stat_text">Allowed Quotas</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>


</odoo>