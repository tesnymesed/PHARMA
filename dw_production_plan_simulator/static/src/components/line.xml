<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="dw_production_plan_simulator.ProductionPlanSimulatorLine">
    <tbody
      class="o_mps_content"
      t-att-data-id="productionSimulation.id"
      t-att-data-warehouse_id="'warehouse_id' in productionSimulation and productionSimulation.warehouse_id[0]"
    >
      <tr class="bg-light">
        <th></th>
        <th scope="col">
          <a
            href="#"
            class="o_prod_sim_record_url"
            t-att-data-res-id="productionSimulation.product_id[0]"
            t-att-data-model="'product.product'"
            t-on-click.prevent="_onClickRecordLink"
            ><t t-esc="productionSimulation.product_id[1]"
          /></a>
          <span
            t-if="'product_uom_id' in productionSimulation"
            class="text-muted"
          >
            by <t t-esc="productionSimulation.product_uom_id[1]"
          /></span>
          <span t-if="'warehouse_id' in productionSimulation">
            - <t t-esc="productionSimulation.warehouse_id[1]"
          /></span>
          <span> </span>
<!--          <a-->
<!--            href="#"-->
<!--            role="button"-->
<!--            title="Forecast Report"-->
<!--            t-attf-class="fa fa-fw fa-area-chart"-->
<!--            t-on-click.prevent="_onClickForecastReport"-->
<!--          />-->
        </th>
        <th />
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <span
              t-attf-class="{{! groups.mrp_mps_show_starting_inventory and 'o_hidden' or 'text-end'}}"
              t-esc="formatFloat(simulation.starting_inventory_qty)"
              data-bs-toggle="tooltip"
              data-bs-placement="bottom"
              title="The forecasted quantity in stock at the beginning of the period."
            />
          </th>
        </t>
      </tr>
      <tr
        name="demand_forecast_year_minus_2"
        t-attf-class="{{! groups.mrp_mps_show_actual_demand_year_minus_2 and 'o_hidden' or ''}}"
      >
        <th />
        <th scope="row">
          <span>Actual Demand Y-2</span>
        </th>
        <th />
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <span t-esc="formatFloat(simulation.outgoing_qty_year_minus_2)" />
          </th>
        </t>
      </tr>

      <tr name="sales_objective">
        <th />
        <th scope="row">
          <span>Sales Objective</span>
        </th>
        <th></th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <span t-esc="formatFloat(simulation.sale_objective_qty)" />
          </th>
        </t>
      </tr>
      <tr name="sales_history">
        <th />
        <th scope="row">
          <span>Sold Quantity</span>
        </th>
        <th></th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <span t-esc="formatFloat(simulation.sold_qty)" />
          </th>
        </t>
      </tr>
      <tr
        name="demand_forecast_year_minus_1"
        t-attf-class="{{! groups.mrp_mps_show_actual_demand_year_minus_1 and 'o_hidden' or ''}}"
      >
        <th />
        <th scope="row">
          <span>Actual Demand Y-1</span>
        </th>
        <th></th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <span t-esc="formatFloat(simulation.outgoing_qty_year_minus_1)" />
          </th>
        </t>
      </tr>
      <tr
        t-ref="forecastRow"
        name="demand_forecast"
        t-attf-class="{{! (groups.mrp_mps_show_demand_forecast or groups.mrp_mps_show_actual_demand) and 'o_hidden' or ''}}"
      >
        <th />
        <th scope="row">
          -
          <span
            t-attf-class="{{! groups.mrp_mps_show_actual_demand and 'o_hidden' or ''}}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The confirmed demand, based on the confirmed sales orders."
            >Actual</span
          >
          <span
            t-attf-class="{{! (groups.mrp_mps_show_actual_demand and groups.mrp_mps_show_demand_forecast) and 'o_hidden' or ''}}"
          >
            /
          </span>
          <span
            t-attf-class="{{! groups.mrp_mps_show_demand_forecast and 'o_hidden' or ''}}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The forecasted demand. This value has to be entered manually."
            >Forecasted Demand</span
          >
        </th>
        <th></th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <a
              href="#"
              name="actual_demand"
              t-on-click="_onClickOpenDetails"
              data-action="action_open_actual_demand_details"
              t-att-data-date_index="simulation_index"
              t-att-data-date_start="simulation.date_start"
              t-att-data-date_stop="simulation.date_stop"
              t-attf-class="{{! groups.mrp_mps_show_actual_demand and 'o_hidden' or 'o_prod_sim_open_details'}}"
            >
              <t t-esc="formatFloat(simulation.outgoing_qty)" />
            </a>
            <span
              t-attf-class="{{! (groups.mrp_mps_show_actual_demand and groups.mrp_mps_show_demand_forecast) and 'o_hidden' or ''}}"
            >
              /
            </span>
            <input
              type="text"
              t-att-data-date_index="simulation_index"
              t-attf-class="text-end form-control o_prod_sim_input_forcast_qty {{! groups.mrp_mps_show_demand_forecast and 'o_hidden' or groups.mrp_mps_show_actual_demand and 'o_mps_inline' or ''}}"
              t-att-value="formatFloat(simulation.forecast_qty)"
              t-on-change.stop="(ev) => this._onChangeForecast(ev, productionSimulation.id)"
              t-on-focus.prevent="_onFocusInput"
            />
          </th>
        </t>
      </tr>
      <tr
        name="indirect_demand"
        t-attf-class="{{(! groups.mrp_mps_show_indirect_demand or ! productionSimulation.has_indirect_demand) and 'o_hidden' or ''}}"
      >
        <th />
        <th
          scope="row"
          data-bs-toggle="tooltip"
          data-bs-placement="bottom"
          title="The forecasted demand to fulfill the needs in components of the Manufacturing Orders."
        >
          - Indirect Demand Forecast
        </th>
        <th />
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th
            t-attf-class="text-end pe-4 {{simulation.indirect_demand_qty == 0 and 'text-muted' or ''}}"
          >
            <t t-esc="formatFloat(simulation.indirect_demand_qty)" />
          </th>
        </t>
      </tr>
      <tr
        t-ref="replenishRow"
        name="to_replenish"
        t-attf-class="{{! (groups.mrp_mps_show_to_replenish or groups.mrp_mps_show_actual_replenishment) and 'o_hidden' or ''}}"
      >
        <th />
        <th scope="row">
          +
          <span
            t-attf-class="{{! groups.mrp_mps_show_actual_replenishment and 'o_hidden' or ''}}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The quantity being replenished, based on the Requests for Quotation and the Manufacturing Orders."
            >Actual</span
          >
          <span
            t-attf-class="{{! (groups.mrp_mps_show_actual_replenishment and groups.mrp_mps_show_to_replenish) and 'o_hidden' or ''}}"
          >
            /
          </span>
          <span
            t-attf-class="{{! groups.mrp_mps_show_to_replenish and 'o_hidden' or ''}}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The quantity to replenish through Purchase Orders or Manufacturing Orders."
            >Suggested Replenishment
          </span>
          <button
            type="button"
            title="Replenish"
            t-attf-class="{{! groups.mrp_mps_show_to_replenish and 'o_hidden' or 'btn btn-secondary o_no_padding o_prod_sim_procurement'}}"
            t-on-click.stop="() => this._onClickReplenish(productionSimulation.id)"
            t-on-mouseover.stop="_onMouseOverReplenish"
            t-on-mouseout.stop="_onMouseOutReplenish"
          >
            Replenish
          </button>
        </th>
        <th class="text-end">
          <button
            type="button"
            t-attf-class="{{! groups.mrp_mps_show_to_replenish and 'o_hidden' or 'btn btn-link o_no_padding o_prod_sim_edit'}}"
            t-on-click.stop="(ev) => this._onClickEdit(ev, productionSimulation.id)"
          >
            <t t-esc="productionSimulation.min_to_replenish_qty" />
            &#8804;&#8230;&#8804;
            <t t-esc="productionSimulation.max_to_replenish_qty" />
          </button>
        </th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th
            t-attf-class="o_forecast_stock text-end pe-4 {{
                        simulation.to_replenish and 'o_prod_sim_to_replenish' or ''
                        }} {{
                        simulation.forced_replenish and 'o_prod_sim_forced_replenish' or ''
                        }}"
          >
            <a
              href="#"
              name="actual_replenishment"
              t-on-click.prevent="_onClickOpenDetails"
              data-action="action_open_actual_replenishment_details"
              t-att-data-date_index="simulation_index"
              t-att-data-date_start="simulation.date_start"
              t-att-data-date_stop="simulation.date_stop"
              t-attf-class="o_prod_sim_open_details {{
                            ! groups.mrp_mps_show_actual_replenishment and 'o_hidden'
                            }} {{
                            simulation.to_replenish and 'o_prod_sim_to_replenish' or ''
                            }} {{
                            simulation.forced_replenish and 'o_prod_sim_forced_replenish' or ''
                            }}"
            >
              <t t-esc="formatFloat(simulation.incoming_qty)" />
            </a>
            <span
              t-attf-class="{{! (groups.mrp_mps_show_actual_replenishment and groups.mrp_mps_show_to_replenish) and 'o_hidden' or ''}}"
            >
              /
            </span>
            <div
              t-attf-class="input-group {{! groups.mrp_mps_show_to_replenish and 'o_hidden' or  groups.mrp_mps_show_actual_replenishment and 'o_mps_inline' or ''}}"
            >
              <button
                type="button"
                t-if="simulation.replenish_qty_updated"
                t-on-click.stop="(ev) => this._onClickAutomaticMode(ev, productionSimulation.id)"
                t-att-data-date_index="simulation_index"
                class="btn btn-link input-group-addon o_prod_sim_automatic_mode fa fa-times o_no_padding"
              />
              <input
                type="text"
                t-att-data-date_index="simulation_index"
                t-attf-class="form-control text-end
                                o_prod_sim_input_replenish_qty
                                {{simulation.state == 'launched' and 'alert-dark' or
                                simulation.state == 'to_relaunch' and 'alert-warning' or
                                simulation.state == 'to_correct' and 'alert-danger' or
                                simulation.to_replenish and 'alert-success' or
                                simulation.replenish_qty_updated and 'alert-info' or ''
                                }} {{
                                simulation.to_replenish and 'o_prod_sim_to_replenish' or ''
                                }} {{
                                simulation.forced_replenish and 'o_prod_sim_forced_replenish' or ''
                                }}"
                t-att-value="formatFloat(simulation.replenish_qty)"
                t-on-change.stop="(ev) => this._onChangeToReplenish(ev, productionSimulation.id)"
                t-on-focus="_onFocusInput"
              />
            </div>
          </th>
        </t>
      </tr>
      <tr
        name="safety_stock"
        t-attf-class="{{! (groups.mrp_mps_show_safety_stock or groups.mrp_mps_show_available_to_promise) and 'o_hidden' or ''}}"
      >
        <th />
        <th scope="row">
          =
          <span
            t-attf-class="{{! groups.mrp_mps_show_available_to_promise and 'o_hidden' or ''}}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="Quantity predicted to be available for sale at the end of the period (= to replenish - actual demand)."
            >ATP</span
          >
          <span
            t-attf-class="{{! (groups.mrp_mps_show_safety_stock and groups.mrp_mps_show_available_to_promise) and 'o_hidden' or ''}}"
          >
            /
          </span>
          <span
            t-attf-class="{{! groups.mrp_mps_show_safety_stock and 'o_hidden' or ''}}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The forecasted quantity in stock at the end of the period."
            >Forecasted Stock</span
          >
        </th>
        <th class="text-end">
          <button
            type="button"
            t-attf-class="{{! groups.mrp_mps_show_safety_stock and 'o_hidden' or 'btn btn-link text-muted o_no_padding o_prod_sim_edit'}}"
            t-on-click.stop="(ev) => this._onClickEdit(ev, productionSimulation.id)"
          >
            <span
              class="fa fa-bullseye text-muted fa-fw"
              role="img"
              aria-label="Forecasted"
              title="Forecasted"
            />
            <t t-esc="productionSimulation.safety_stock_target_qty or 0.0" />
          </button>
        </th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <span
              t-attf-class="{{! groups.mrp_mps_show_available_to_promise and 'o_hidden' or ''}}"
              t-esc="formatFloat(simulation.starting_inventory_qty + simulation.replenish_qty - simulation.outgoing_qty)"
            />
            <span
              t-attf-class="{{! (groups.mrp_mps_show_safety_stock and groups.mrp_mps_show_available_to_promise) and 'o_hidden' or ''}}"
            >
              /
            </span>
            <span
              t-attf-class="{{simulation.safety_stock_qty &lt; 0 and 'text-danger' or ''}} {{! groups.mrp_mps_show_safety_stock and 'o_hidden' or ''}}"
              t-esc="formatFloat(simulation.safety_stock_qty)"
            />
          </th>
        </t>
      </tr>
    </tbody>
  </t>
</templates>
