      <tr t-ref="forecastRow" name="demand_forecast" t-attf-class="{{ '' }}">
        <th />
        <th scope="row">
          -
          <span
            t-attf-class="{{ '' }}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The confirmed demand, based on the confirmed sales orders."
            >Actual</span
          >
          <span t-attf-class="{{ '' }}"> / </span>
          <span
            t-attf-class="{{ '' }}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The forecasted demand. This value has to be entered manually."
            >Forecasted Demand</span
          >
        </th>
        <th></th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <a
              href="#"
              name="actual_demand"
              t-on-click="_onClickOpenDetails"
              data-action="action_open_actual_demand_details"
              t-att-data-date_index="simulation_index"
              t-att-data-date_start="simulation.date_start"
              t-att-data-date_stop="simulation.date_stop"
              t-attf-class="{{ 'o_prod_sim_open_details' }} "
            >
              <t t-esc="formatFloat(simulation.outgoing_qty)" />
            </a>
            <span t-attf-class="{{ '' }}"> / </span>
            <input
              type="text"
              t-att-data-date_index="simulation_index"
              t-attf-class="text-end form-control o_prod_sim_input_forcast_qty  {{
                'o_mps_inline'
              }}"
              t-att-value="formatFloat(simulation.forecasted_demand_qty)"
              t-on-change.stop="(ev) => this._onChangeForecast(ev, productionSimulation.id)"
              t-on-focus.prevent="_onFocusInput"
            />
          </th>
        </t>
      </tr>

      <tr t-ref="replenishRow" name="to_replenish" t-attf-class="{{ '' }}">
        <th />
        <th scope="row">
          +
          <span
            t-attf-class="{{ '' }}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The quantity being replenished, based on the Requests for Quotation and the Manufacturing Orders."
            >Actual</span
          >
          <span t-attf-class="{{ '' }}"> / </span>
          <span
            t-attf-class="{{ '' }}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The quantity to replenish through Purchase Orders or Manufacturing Orders."
            >Suggested Replenishment
          </span>
        </th>
        <th class="text-end"></th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th
            t-attf-class="o_forecast_stock text-end pe-4  {{
                        simulation.to_replenish and 'o_prod_sim_to_replenish' or ''
                        }} {{
                        simulation.forced_replenish and 'o_prod_sim_forced_replenish' or ''
                        }}"
          >
            <a
              href="#"
              name="actual_replenishment"
              t-on-click.prevent="_onClickOpenDetails"
              data-action="action_open_actual_replenishment_details"
              t-att-data-date_index="simulation_index"
              t-att-data-date_start="simulation.date_start"
              t-att-data-date_stop="simulation.date_stop"
              t-attf-class="o_prod_sim_open_details  {{
                            simulation.to_replenish and 'o_prod_sim_to_replenish' or ''
                            }} {{
                            simulation.forced_replenish and 'o_prod_sim_forced_replenish' or ''
                            }}"
            >
              <t t-esc="formatFloat(simulation.incoming_qty)" />
            </a>
            <span t-attf-class="{{ '' }}"> / </span>
            <div t-attf-class="input-group {{ 'o_mps_inline' }}">
              <button
                type="button"
                t-if="simulation.replenish_qty_updated"
                t-on-click.stop="(ev) => this._onClickAutomaticMode(ev, productionSimulation.id)"
                t-att-data-date_index="simulation_index"
                class="btn btn-link input-group-addon o_prod_sim_automatic_mode fa fa-times o_no_padding"
              />
              <input
                type="text"
                t-att-data-date_index="simulation_index"
                t-attf-class="form-control text-end 
                                o_prod_sim_input_replenish_qty
                                {{simulation.state == 'launched' and 'alert-dark' or
                                simulation.state == 'to_relaunch' and 'alert-warning' or
                                simulation.state == 'to_correct' and 'alert-danger' or
                                simulation.to_replenish and 'alert-success' or
                                simulation.replenish_qty_updated and 'alert-info' or ''
                                }} {{
                                simulation.to_replenish and 'o_prod_sim_to_replenish' or ''
                                }} {{
                                simulation.forced_replenish and 'o_prod_sim_forced_replenish' or ''
                                }}"
                t-att-value="formatFloat(simulation.replenish_qty)"
                t-on-change.stop="(ev) => this._onChangeToReplenish(ev, productionSimulation.id)"
                t-on-focus="_onFocusInput"
              />
            </div>
          </th>
        </t>
      </tr>
      <tr name="safety_stock" t-attf-class="{{ '' }}">
        <th />
        <th scope="row">
          =
          <span
            t-attf-class="{{ '' }}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="Quantity predicted to be available for sale at the end of the period (= to replenish - actual demand)."
            >ATP</span
          >
          <span t-attf-class="{{ '' }}"> / </span>
          <span
            t-attf-class="{{ '' }}"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="The forecasted quantity in stock at the end of the period."
            >Forecasted Stock</span
          >
        </th>
        <th class="text-end"></th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <span
              t-attf-class="{{ '' }}"
              t-esc="formatFloat(simulation.starting_inventory_qty + simulation.replenish_qty - simulation.outgoing_qty)"
            />
            <span t-attf-class="{{ '' }}"> / </span>
            <span
              t-attf-class="{{simulation.safety_stock_qty &lt; 0 and 'text-danger' or ''}}"
              t-esc="formatFloat(simulation.safety_stock_qty)"
            />
          </th>
        </t>
      </tr>
      <!-- <ProductionPlanBatchesNotesEditor
          data="this.formVals"
        /> -->
      <!-- Prod Plan Batch Notes Modal -->

      <div
        class="modal fade"
        t-attf-id="prodPlanBatchNotesModal-{{ productionSimulation.id }}"
        tabindex="-1"
        role="dialog"
        aria-labelledby="formVals.title"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-centered" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h5
                class="modal-title"
                t-attf-id="prodPlanBatchNotesModalHeadTitle-{{
                  productionSimulation.id
                }}"
              >
                <t t-esc="formVals.headerTitle"></t>
              </h5>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="notes-wizard modal-body">
              <div class="period">
                <h2
                  t-attf-id="modalProductHeader-{{ productionSimulation.id }}"
                  t-att-value="formVals.modalProductHeader"
                >
                  <t t-esc="formVals.modalProductHeader"></t>
                </h2>
                <h3
                  t-attf-id="modalPeriodSubHeader-{{ productionSimulation.id }}"
                  t-att-value="formVals.modalPeriodSubHeader"
                >
                  <t t-esc="formVals.modalPeriodSubHeader"></t>
                </h3>
              </div>
              <form>
                <div class="batch-quantities form-group row">
                  <div class="batch-quantity-container col">
                    <div class="batch-quantity-label">
                      <label
                        t-attf-for="production-plan-batches-{{
                          productionSimulation.id
                        }}"
                        >Production Plan Batches</label
                      >
                    </div>
                    <div class="batch-quantity">
                      <span
                        class="batch-quantity"
                        t-attf-id="production-plan-batches-{{
                          productionSimulation.id
                        }}"
                        t-esc="formVals.eff_planned_production_batches"
                      />
                    </div>
                    <!-- t-attf-class="{{formatFloat(formVals.eff_planned_production_batches) &gt;
                      formatFloat(formVals.batch_count) and 'text-success' or
                                       'text-danger' or ''
                                      }}" -->
                  </div>
                  <div class="batch-quantity-container col">
                    <div class="batch-quantity-label">
                      <label
                        t-attf-for="suggested-production-plan-batches-{{
                          productionSimulation.id
                        }}"
                        >Suggested Production Plan Batches</label
                      >
                    </div>
                    <div class="batch-quantity">
                      <span
                        class="batch-quantity"
                        t-attf-id="suggested-production-plan-batches-{{
                          productionSimulation.id
                        }}"
                        t-esc="formVals.batch_count"
                      />
                    </div>
                    <!-- t-attf-class="{{formatFloat(formVals.batch_count) &lt;
                        formatFloat(formVals.eff_planned_production_batches) and 'text-success' or
                                         'text-danger' or ''
                                        }}" -->
                    <!-- <input
                      type="text"
                      id="suggested-production-plan-batches"
                      name="suggested-production-plan-batches"
                      readonly="True"
                    /> -->
                  </div>
                </div>
                <div class="notes-container form-group row">
                  <label
                    t-attf-for="notes-{{ productionSimulation.id }}"
                    class="notes-label"
                    >Notes:</label
                  >
                  <textarea
                    t-attf-id="notes-{{ productionSimulation.id }}"
                    t-attf-class="notes-textarea"
                    type="text"
                    t-att-value="formVals.notes"
                    placeholder="Enter your notes here..."
                  />
                </div>
              </form>
            </div>
            <div class="modal-footer">
              <button
                type="button"
                class="btn btn-secondary"
                data-dismiss="modal"
                data-bs-dismiss="modal"
                aria-label="Close"
              >
                Close
              </button>
              <button
                type="button"
                t-on-click.prevent="(ev) => this.saveProdPlanBatchesNotes(ev, productionSimulation.id)"
                class="btn btn-primary"
              >
                Save notes
              </button>
            </div>
          </div>
        </div>
      </div>
    </tbody>
  </t>
</templates>
