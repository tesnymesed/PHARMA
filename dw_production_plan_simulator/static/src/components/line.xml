          <span>Suggested Production Plan Batches</span>
        </th>
        <th></th>
        <t
          t-foreach="productionSimulation.product_plan_sim_ids"
          t-as="simulation"
          t-key="simulation_index"
        >
          <th class="text-end pe-4">
            <!--            <span t-esc="formatFloat(simulation.batch_count)" />-->
