              type="text"
              t-att-data-date_index="simulation_index"
              t-attf-class="text-end form-control o_prod_sim_input_forcast_qty o_mps_inline "
              t-att-value="formatFloat(simulation.batch_count)"
              t-on-change.stop="(ev) => this.onChangeBatchCount(ev, productionSimulation.id)"
              t-on-focus.prevent="_onFocusInput"
            />
            <span
              t-if="simulation.batch_count != simulation.eff_planned_production_batches"
              t-att-data-id="productionSimulation.id"
              t-att-data-date_index="simulation_index"
              t-att-data-date_start="simulation.date_start"
              t-att-data-date_stop="simulation.date_stop"
              t-att-data-notes="simulation.notes"
              t-att-data-product="productionSimulation.product_id[1]"
              t-att-data-batch_count="simulation.batch_count"
              t-att-data-eff_planned_production_batches="simulation.eff_planned_production_batches"
              class="btn btn-link input-group-addon fa fa-commenting fa-fw pe-1 text-success oe_edit_only o_no_padding"
              t-attf-title="Add/Edit notes."
              t-on-click="(ev) => this._onClickProdPlanBatchesNotes(ev, productionSimulation.id)"
            />
          </th>
        </t>
      </tr>

