<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <div
    t-name="production_plan_simulator.prod_plan_sim_template"
    class="main o_action"
    owl="1"
  >
    <head>
      <link
        rel="stylesheet"
        type="text/css"
        href="dw_mrp_plan/static/src/components/tab/main_dashboard.css"
      />
    </head>
    <!-- Layout wrapper -->
    <div
      class="layout-wrapper layout-content-navbar"
      style="max-height: 100%; overflow: auto"
    >
      <div class="layout-container">
        <div class="layout-page">
          <div class="content-wrapper">
            <div class="container-fluid flex-grow-1 container-p-y">
              <div class="row">
                <div class="col-xxl">
                  <div class="card mb-4">
                    <div
                      class="card-header d-flex align-items-center justify-content-between"
                    >
                      <h5 class="mb-0">Settings</h5>
                    </div>
                    <div class="card-body">
                      <div class="row mb-3">
                        <div class="col-sm-4">
                          <label for="select-company" class="form-label"
                            >Company</label>
                          <select
                            id="select-company"
                            class="form-select"
                            data-placeholder="Company ..."
                            t-on-change.stop="(ev) => this._onChangeCompany(ev)"
                          ></select>
                        </div>

                        <!--                        <div class="col-sm-4">-->
                        <!--                          <label for="select-planning-cycle" class="form-label"-->
                        <!--                            >Planning Cycle</label-->
                        <!--                          >-->
                        <!--                          <select-->
                        <!--                            id="select-planning-cycle"-->
                        <!--                            class="form-select"-->
                        <!--                            data-placeholder="Planning Cycle ..."-->
                        <!--                            t-on-change.stop="(ev) => this._onChangePlanningCycle(ev)"-->
                        <!--                          ></select>-->
                        <!--                        </div>-->

                        <!--                        <div class="col-sm-4">-->
                        <!--                          <label for="planning-period" class="form-label"-->
                        <!--                            >Planning Period (Exercice de planification):</label-->
                        <!--                          >-->
                        <!--                          <input id="planning-period" class="form-select" />-->
                        <!--                        </div>-->
                      </div>

                      <div class="row mb-12">
                        <div class="col-6">
                          <div class="col-6">
                            <label
                              for="plan-date-range-start"
                              class="form-label"
                              >Planning Period Start</label>
                            <input
                              id="plan-date-range-start"
                              class="form-select"
                            />
                          </div>
                          <div class="col-6">
                            <label for="plan-date-range-end" class="form-label"
                              >Planning Period End</label>
                            <input
                              id="plan-date-range-end"
                              class="form-select"
                            />
                          </div>
                        </div>
                        <div class="col-6">
                          <div class="col-6">
                            <label
                              for="sales-avg-range-start"
                              class="form-label"
                              >Sales AVG Period Start</label>
                            <input
                              id="sales-avg-range-start"
                              class="form-select"
                            />
                          </div>

                          <div class="col-6">
                            <label for="sales-avg-range-end" class="form-label"
                              >Sales AVG Period End</label>
                            <input
                              id="sales-avg-range-end"
                              class="form-select"
                            />
                          </div>
                        </div>

                        <!-- <div class="col-sm-4">
                                <label
                                  for="sales-avg-period"
                                  class="col-sm-2 col-form-label"
                                  >Sales AVG</label>
                                <input
                                  class="date-own form-control"
                                  id="sales-avg-period"
                                  name="daterange"
                                  type="text"
                                  value="01/01/2024 - 03/01/2024"
                                />
                              </div> -->
                      </div>

                      <div class="row mb-3"></div>

                      <div class="row justify-content-end">
                        <div class="col-sm">
                          <button
                            type="submit"
                            id="submit"
                            class="btn btn-primary"
                          >
                            Simulate
                          </button>
                        </div>

                        <div class="col-sm">
                          <t t-if="workCenterCapacities.length > 0">
                            <button
                              type="show-alerts"
                              id="show-alerts"
                              class="btn btn-primary"
                              t-on-click="toggleModal"
                              t-on-mouseover.stop="_onMouseOverCapacityAlert"
                              t-on-mouseout.stop="_onMouseOutCapacityAlert"
                            >
                              Display Alerts
                            </button>
                          </t>
                        </div>

                        <div class="col-sm">
                          <t t-if="simulationLines.length">
                            <button
                              type="create-mps"
                              id="create-mps"
                              class="btn btn-primary"
                              t-on-click="_createMasterProductionSchedule"
                            >
                              Create MRP Plan
                            </button>
                          </t>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <t t-if="simulationLines.length">
                <div class="row">
                  <div class="col-xxl">
                    <div class="card mb-4" style="max-height: 90%">
                      <div
                        class="card-header d-flex align-items-center justify-content-between"
                      >
                        <h5 class="mb-0">Planner</h5>
                      </div>
                      <div class="o_prod_sim o_content bg-view">
                        <div class="row">
                          <div class="text-nowrap mr0 ml0">
                            <div id="wrap" class="oe_structure">
                              <table class="table o_mps_product_table">
                                <t
                                  t-foreach="workCenters"
                                  t-as="workCenter"
                                  t-key="workCenter.key"
                                >
                                  <thead class="table-light">
                                    <tr>
                                      <th
                                        scope="row"
                                        t-attf-colspan="{{manufacturingPeriods.length + 3}}"
                                        style="float: none;"
                                      >
                                        <a
                                          href="#"
                                          class="o_prod_sim_record_url"
                                          t-attf-data-id="{{workCenter.key}}"
                                          t-att-data-model="'mrp.workcenter'"
                                          t-on-click.prevent="(ev) => this._onClickWorkCenterLink(ev, workCenter.key)"
                                          style="font-size: 1.5em; display: inline-block; text-decoration: none;"
                                        >
                                          <t
                                            t-esc="workCenter.key.split(',')[1]"
                                          />
                                        </a>
                                      </th>
                                    </tr>
                                  </thead>

                                  <tbody>
                                    <tr>
                                      <table class="table o_mps_product_table">
                                        <thead class="table-light">
                                          <tr class="o_mps_period">
                                            <th></th>
                                            <th />
                                            <th />
                                            <th
                                              class="text-end pe-4"
                                              scope="col"
                                              t-foreach="manufacturingPeriods"
                                              t-as="period"
                                              t-key="period_index"
                                            >
                                              <div
                                                t-att-data-date_index="period_index"
                                              >
                                                <t t-esc="period" />
                                              </div>
                                            </th>
                                          </tr>
                                        </thead>

                                        <t
                                          t-foreach="workCenter.values"
                                          t-as="productionSimulation"
                                          t-key="productionSimulation.id"
                                        >
                                          <ProductionPlanSimulatorLine
                                            data="productionSimulation"
                                            groups="groups"
                                            isVisible="productionSimulation.isVisible"
                                          />
                                        </t>
                                      </table>
                                    </tr>
                                  </tbody>
                                </t>
                              </table>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </t>

              <t t-if="!simulationLines.length">
                <div class="row">
                  <div class="col-xxl">
                    <div class="card mb-4" style="height: 500px">
                      <div
                        class="card-header d-flex align-items-center justify-content-between"
                      >
                        <h5 class="mb-0">Planner</h5>
                      </div>
                      <div class="o_prod_sim o_content bg-view">
                        <t t-call="prod_sim_nocontent_helper" />
                      </div>
                    </div>
                  </div>
                </div>
              </t>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- <ProductionPlanSimulationAlerts t-if="isModalVisible" /> -->

    <!-- Alerts modal -->
    <div
      class="modal fade"
      id="alerts-modal"
      tabindex="-1"
      aria-labelledby="ModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="ModalTitle"></h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body" id="alerts-modal">
            <!--          Body -->
            <center>
              <h3 id="bodyTitle"></h3>
            </center>

            <div id="alertsTable" class="table table-hover"></div>

            <table class="table table-striped">
              <thead id="tableHead"></thead>
              <tbody id="tableBody"></tbody>
            </table>
            <div id="dynamic-input-form">
              <div id="newRow"></div>
            </div>
            <!--Body
                  End-->
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
              data-bs-dismiss="modal"
              aria-label="Close"
            >
              Close
            </button>
            <button
              type="button"
              t-on-click="closeAlertsModal"
              id="save"
              class="btn btn-primary"
            >
              Validate
            </button>
          </div>
        </div>
        <!--        <MainComponent action="_MPSAction" />-->
      </div>
    </div>
  </div>

  <t t-name="prod_sim_nocontent_helper">
    <div class="o_view_nocontent">
      <div class="o_nocontent_help">
        <!--        <p class="o_view_nocontent_smiling_face">-->
        <!--          No company was selected. Select one to start simulating.-->
        <!--        </p>-->
        <p>
          The Production Plan Simulator translates your sales and demand
          forecasts into a production and purchase planning for each finished
          product. It ensures everything gets scheduled on time, based on
          constraints such as: safety stock, production capacity, lead times.
          It's the perfect tool to support your S&amp;OP meetings.
        </p>
        <div class="row justify-content-end">
          <div class="col-sm-12">
            <button
              type="submit"
              id="add-products"
              class="btn btn-primary"
              t-on-click.stop="_onClickCreate"
            >
              Load Products
            </button>
          </div>
        </div>
      </div>
    </div>
  </t>
</templates>