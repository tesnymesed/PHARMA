<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dw_production_plan_simulator_production_plan_simulation_form_view"
        model="ir.ui.view">
        <field name="name">dw.production.plan.simulation.form.view</field>
        <field name="model">dw.production.plan.simulation</field>
        <field name="arch" type="xml">
            <form>
                <field name="company_id" invisible="1" />
                <field name="product_tmpl_id" invisible="1" />
                <!--                <field name="dw_simulation_ok" invisible="1"/>-->

                <group>
                    <group>
                        <field name="product_id" />
                        <field name="bom_id" />
                        <field name="lot_size" readonly="0" />
                    </group>
                    <group>
                        <field name="warehouse_id" />
                        <field name="workcenter_id"
                            context="{'dw_bypass_pharma_simulation': False, 'dw_pharma_simulation': True}" />
                        <field name="workcenter_default_capacity" readonly="0" />

                    </group>
                    <group>
                        <label for="sales_average" />
                        <div class="o_row">
                            <field name="sales_average" />
                            <field name="product_uom_id" groups="uom.group_uom" readonly="1" />
                        </div>
                        <label for="safety_stock_target" />
                        <div class="o_row">
                            <field name="safety_stock_target" />
                            <span>Months</span>

                        </div>
                        <label for="safety_stock_target_qty" />
                        <div class="o_row">
                            <field name="safety_stock_target_qty" />
                            <field name="product_uom_id" groups="uom.group_uom" readonly="1" />
                        </div>
                    </group>
                </group>
                <footer>
                    <button special="save" data-hotkey="q" type="object" string="Save"
                        class="btn-primary" />
                    <button string="Cancel" class="btn btn-secondary" special="cancel"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>