    <record id="action_dw_mrp_mps" model="ir.actions.client">
        <field name="name">Simulated X Master Production Schedule</field>
        <field name="res_model">mrp.production.schedule</field>
        <field name="tag">dw_mrp_mps_client_action</field>
        <field name="context" eval="{'dw_bypass_pharma_simulation': False}"/>
    </record>

    <record id="dw_production_plan_simulator_production_plan_simulation_form_view"
            model="ir.ui.view">
        <field name="name">dw.production.plan.simulation.form.view</field>
        <field name="model">dw.production.plan.simulation</field>
        <field name="arch" type="xml">
            <form>
                <field name="company_id" invisible="1"/>
                <field name="product_tmpl_id" invisible="1"/>
                <!--                <field name="dw_simulation_ok" invisible="1"/>-->

                <group>
                    <group>
                        <field name="product_id"/>
                        <field name="bom_id"/>
                        <label for="lot_size"/>
                        <div class="o_row">
                            <field name="lot_size" readonly="0"/>
                            <field name="product_uom_id" groups="uom.group_uom" readonly="1"/>
                        </div>
                    </group>
                    <group>
                        <field name="warehouse_id"/>
                        <field name="workcenter_id"
                               context="{'dw_bypass_pharma_simulation': False, 'dw_pharma_simulation': True}"
                               options="{'no_open': True}"
                        />
                        <label for="workcenter_default_capacity"/>
                        <div class="o_row">
                            <field name="workcenter_default_capacity" readonly="1"/>
                            <field name="product_uom_id" groups="uom.group_uom" readonly="1"/>
                        </div>

                    </group>
                    <group>
                        <label for="sales_average"/>
                        <div class="o_row">
                            <field name="sales_average"/>
                            <field name="product_uom_id" groups="uom.group_uom" readonly="1"/>
                        </div>
                        <label for="safety_stock_target"/>
                        <div class="o_row">
                            <field name="safety_stock_target"/>
                            <span>Months</span>
                        </div>
                        <label for="safety_stock_target_qty"/>
                        <div class="o_row">
                            <field name="safety_stock_target_qty"/>
                            <field name="product_uom_id" groups="uom.group_uom" readonly="1"/>
                        </div>
                    </group>
                </group>
                <footer>
                    <button special="save" data-hotkey="q" type="object" string="Save"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="dw_mrp_sim_workcenter_action" model="ir.actions.act_window">
        <field name="name">Simulation Work Centers</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,kanban,form</field>

        <field name="context" eval="{'dw_bypass_pharma_simulation': False, 'dw_pharma_simulation': True}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new simulation work center
            </p>
            <p>
                Manufacturing operations are processed at Work Centers. A Work Center can be composed of
                workers and/or machines, they are used for costing, scheduling, capacity planning, etc.
            </p>
        </field>
    </record>
