<odoo>

    <record id="sample_request_form_view" model="ir.ui.view">
        <field name="name">sample.request.form</field>
        <field name="model">sample.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>

                    <button name="action_confirm" string="Confirm"
                            class="btn-primary"
                            invisible="state not in  ['draft']"
                            type="object"/>
                    <button name="action_validate" string="Valid"
                            class="btn-primary"
                            invisible="state not in  ['confirm']"
                            type="object"/>
                    <button name="action_reject" string="Reject"
                            type="object"
                            invisible="state not in  ['draft']"
                            class="btn-secondary"/>
                    <button
                            name="action_canceled" string="Cancel"
                            type="object"
                            invisible="state in  ['validate','cancel']"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="state not in ['draft','confirm']"/>
                    </h1>
                    <group>
                        <group>
                            <field name="product_id" readonly="state not in ['draft','confirm']"
                                   options='{"no_create":True}'/>
                            <field name="lot_id" readonly="state not in ['draft','confirm']"/>
                            <field name="user_id" readonly="state not in ['draft','confirm']"/>
                            <field name="request_time" readonly="state not in ['draft','confirm']"/>
                        </group>
                        <group>
                            <field name="validation_time" readonly="state not in ['draft','confirm']"/>
                            <field name="validation_by" readonly="state not in ['draft','confirm']"/>
                            <field name="company_id" readonly="state not in ['draft','confirm']"
                                   options='{"no_create":True}'/>
                        </group>
                        <notebook>
                            <page string="Sample Information">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="lot_id"/>
                                        <field name="product_uom_qty"/>
                                        <field name="product_uom"/>
                                        <field name="simple_request_id" column_invisible="True"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="sample_request_tree_view" model="ir.ui.view">
        <field name="name">sample.request.tree</field>
        <field name="model">sample.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="lot_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="request_time" optional="show"/>
                <field name="validation_time" optional="hide"/>
                <field name="validation_by" optional="hide"/>
                <field name="company_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_quality_sample_request" model="ir.actions.act_window">
        <field name="name">Sample Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sample.request</field>
    </record>

    <menuitem
            id="menu_quality_sample_request"
            name="Sample Request"
            action="action_quality_sample_request"
            parent="quality_control.menu_quality_control"
    />

</odoo>