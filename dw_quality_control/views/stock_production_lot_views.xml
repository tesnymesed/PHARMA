<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="dw_view_production_lot_form_inherit" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="dw_num_supplier"/>
            </field>
        </field>
    </record>
    <record id="dw_view_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']//tree//field[@name='location_id']"
                   position="attributes">

                <attribute name="force_save">True</attribute>
                <attribute name="store">True</attribute>

            </xpath>
            <xpath expr="//button[@name='action_assign']" position="before">
                <field name="dw_route_no_origin" invisible="1"/>
                <button name="dw_recompute_state" type="object" string="Corriger Réservation" class="oe_highlight"
                        attrs="{'invisible': [('dw_route_no_origin', '!=', True)]}"/>
            </xpath>
        </field>
    </record>
</odoo>