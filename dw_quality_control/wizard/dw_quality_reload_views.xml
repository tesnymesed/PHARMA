<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="dw_quality_reload_wizard_form" model="ir.ui.view">
        <field name="name">dw.quality.reload.form</field>
        <field name="model">dw.quality.reload</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>Lot/série</h1>
                    <group>
                        <field name="lot_id" readonly="1"/>
                        <field name="check_quality_id" readonly="1"/>
                        <field name="location_ids" invisible="1"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                    <field name="location_ids" widget="one2many" nolabel="1" readonly="1" style="pointer-events:none;">
                        <tree string="Account Mapping">
                            <field name="warehouse_id"/>
                            <field name="quantity"/>
                            <field name="location_id"/>
                            <field name="dest_location_id"/>
                        </tree>
                    </field>
                    <footer>
                        <button name="action_reload" string="Reload" class="oe_highlight" type="object"
                                invisible="not location_ids"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>