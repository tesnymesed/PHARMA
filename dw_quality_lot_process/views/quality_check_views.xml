<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="check_quality_form" model="ir.ui.view">
        <field name="name">quality.check.form</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[2]" position="after">
                <group>
                    <field name="check_lot_compiliance"/>
                </group>
            </xpath>
            <xpath expr="//header/button[@name='do_fail'][1]" position="attributes">
                <attribute name="invisible">quality_state != 'none' or check_lot_compiliance == True</attribute>
            </xpath>

            <xpath expr="//header/button[@name='do_fail'][2]" position="attributes">
                <attribute name="invisible">quality_state != 'pass' or check_lot_compiliance == True</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="do_fail_process" type="object" class="btn-primary" invisible="check_lot_compiliance == False or quality_state =='fail' " string="Fail" data-hotkey="q" groups="dw_quality_lot_process.check_compiliance_lot_configuration_group"/>
            </xpath>
        </field>
    </record>
</odoo>