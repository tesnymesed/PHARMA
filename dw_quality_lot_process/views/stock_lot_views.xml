<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">
    
        <record id="stock_lot_form_view_inherited" model="ir.ui.view">
            <field name="name">stcok.lot.form.inherited</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form//sheet" position="before">
                    <field name="compiliance_check"  invisible="1"/>
                    <header groups="dw_quality_lot_process.check_compiliance_lot_configuration_group">
                        <button name="action_set_quarantine" type="object" class="btn-primary"
                        invisible="lot_status != 'cancelled' or product_id==False or compiliance_check == False" string="Set quarantine"/>

                        <button name="action_set_conform" type="object" class="btn-primary"
                        invisible="lot_status != 'quarantine' or lot_quarantine_status!='analyzed'or product_id==False or compiliance_check == False" string="Set conform"/>

                        <button name="action_set_not_conform" type="object" string="Set Not Conform" class="btn-primary"
                            invisible="lot_status !='quarantine' or lot_quarantine_status!='analyzed'or product_id==False or compiliance_check == False"/>

                        <button name="action_set_blocked" type="object" string="Block" class="btn-primary"
                        invisible="lot_status not in ['conform','not_conform'] or product_id==False or compiliance_check == False"/>

                        <button name="action_set_cancelled" type="object" string="Cancel" class="btn-primary"
                            invisible="lot_status not in ['conform','not_conform'] or product_id==False or compiliance_check == False"/>
                        
                        
                        <field name="lot_status" widget="statusbar" invisible=" product_id==False or compiliance_check == False"/>
                    
                    </header>
                    <header invisible="lot_status!='quarantine' or product_id==False or compiliance_check == False" groups="dw_quality_lot_process.check_compiliance_lot_configuration_group">
                        <button name="action_set_in_progress" type="object" string="In progress"
                        invisible ="lot_quarantine_status not in ['draft','reanalyzed']"/>
                        <button name="action_set_analyzed" type="object" string="Analyze"
                        invisible="lot_quarantine_status not in ['in_progress']"/>
                        <button name="action_set_reanalyzed" type="object" string="Reanalyze"
                        invisible="lot_quarantine_status!='analyzed'"/>
                        <field name="lot_quarantine_status" widget="statusbar"/>
                    </header>
                </xpath>
                <xpath expr="//form/sheet/notebook" position="inside">
                    <page string="Status History" groups="dw_quality_lot_process.check_compiliance_lot_configuration_group">
                        <field name="lot_status_history_ids">
                            <tree>
                                <field name="change_date"/>
                                <field name="previous_status"/>
                                <field name="new_status"/>
                                <field name="previous_lot_quarantine_status"/>
                                <field name="new_lot_quarantine_status"/>
                                <field name="user_id"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
                    
            </field>
        </record>
    </data>
</odoo>
