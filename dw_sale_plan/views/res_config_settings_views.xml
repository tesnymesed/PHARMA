<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sale.dw</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="35"/>
            <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <setting id="order_default_values" position="after">

                    <block name="dw_additional_parameters" title="Additional Parameters">
                        <setting id="sale_plan_sequence" help="Choose the Sale Plan sequence"
                                 title="Add the sale Plan sequence to every generated one">
                            <field name="dw_sale_plan_sequence_id"/>
                        </setting>
                    </block>
                </setting>
            </field>
        </record>

    </data>
</odoo>
