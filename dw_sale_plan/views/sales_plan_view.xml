<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_sale_plan_form" model="ir.ui.view">
        <field name="name">sale.plan.form</field>
        <field name="model">sale.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                                type="object"
                                name="action_print"
                                class="oe_stat_button"
                                icon="fa-folder-open-o"
                                string="Overview"
                        />
                    </div>

                    <group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                        <group>
                            <field name="season_date" required="1"/>
                        </group>
                    </group>

                    <group string="Comparison">
                        <field name="plan_id"/>
                        <button name="action_compare_plan" string="Compare" type="object" class="oe_highlight"/>
                    </group>

                    <notebook>
                        <page name="product_plan" string="Product Plan">
                            <field name="product_plan_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" required="1"/>
                                    <field name="quantity" readonly="1" force_save="1"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="compared_product_id" optional="hide"/>
                                    <field name="compared_name" optional="hide"/>
                                    <field name="compared_quantity" optional="hide"/>
                                    <button name="action_view_quantity_by_month" type="object" class="oe_stat_button"
                                            icon="fa-list"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_plan_months_form" model="ir.ui.view">
        <field name="name">product.sale.plan.months.tree</field>
        <field name="model">product.sale.plan.monthly</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0">
                <field name="date" readonly="1" force_save="1"/>
                <field name="last_sold_quantity" readonly="1" force_save="1"/>
                <field name="quantity"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_plan_tree" model="ir.ui.view">
        <field name="name">sale.plan.tree</field>
        <field name="model">sale.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_plan_search" model="ir.ui.view">
        <field name="name">sale.plan.search</field>
        <field name="model">sale.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="sale_plan_action" model="ir.actions.act_window">
        <field name="name">Sale Plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Sale Plan.
            </p>
        </field>
    </record>



</odoo>