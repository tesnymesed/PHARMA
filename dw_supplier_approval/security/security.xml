            <field name="sequence">12</field>
        </record>

        <record id="group_user_dw_consultation" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="dw_supplier_approval.module_dw_consultation_category"/>
        </record>
        <record id="group_manager_dw_consultation" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="dw_supplier_approval.module_dw_consultation_category"/>
            <field name="implied_ids" eval="[(4, ref('dw_supplier_approval.group_user_dw_consultation'))]"/>

        </record>

