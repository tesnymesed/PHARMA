        <record id="module_dw_homologation_category" model="ir.module.category">
            <field name="name">Homologation</field>
            <!--        <field name="description">Helps you manage your Foreign trade.</field>-->
            <field name="sequence">11</field>
        </record>

        <record id="group_user_dw_homologation" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="dw_supplier_approval.module_dw_homologation_category"/>
        </record>
        <record id="group_manager_dw_homologation" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="dw_supplier_approval.module_dw_homologation_category"/>
            <field name="implied_ids" eval="[(4, ref('dw_supplier_approval.group_user_dw_homologation'))]"/>

        </record>
<!--Consultation-->
 <record id="module_dw_consultation_category" model="ir.module.category">
