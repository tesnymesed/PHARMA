<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_homologation_tree" model="ir.ui.view">
            <field name="name">dw.homologation.tree</field>
            <field name="model">dw.homologation</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" optional="show"/>
                    <field name="market_id" optional="show"/>
                    <field name="state" optional="show"/>
                    <field name="supplier_id" optional="show"/>
                    <field name="dw_supplier_nature" optional="show"/>
                    <field name="product_id" optional="show"/>
                    <field name="lot_validation" optional="show"/>
                    <field name="company_id" optional="show"/>


                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="view_homologation_form">
            <field name="name">dw.homologation.form</field>
            <field name="model">dw.homologation</field>

            <field name="arch" type="xml">
                <form string="Homologation">
                    <header>
                        <button name="button_prospection" string="return to draft"
                                class="btn-primary"
                                invisible="state != 'cancel' "
                                type="object"/>
                        <button name="action_to_analyse" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'prospection'"
                                type="object"/>
                        <button name="action_to_audit" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'analyse' or purchase_id == False"
                                type="object"/>
                        <button name="action_to_lot_validation_or_qualification" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'audit'"
                                type="object"/>
                        <button name="action_to_qualification" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'lot_validation'"
                                type="object"/>

                        <button name="action_homologate" string="Homologuer"
                                class="btn-primary"
                                invisible="state in ['cancel','prospection','audit','lot_validation','homologue']"
                                type="object"/>

                        <button name="create_purchase_order" string="Create Purchase order"
                                class="btn-primary"
                                invisible="state != 'analyse' or purchase_id != False"
                                type="object"/>
                        <button name="action_lunch_consultation" string="Lunch Consultation"
                                class="btn-primary"
                                invisible="state != 'homologue' or consultation_id "
                                type="object"/>

                        <button
                                name="action_cancel" string="Cancel"
                                type="object" class="btn-primary" data-hotkey="q"
                                invisible="state in ['prospection','cancel','homologue'] "
                        />
                        <field name="state" widget="statusbar"
                               statusbar_visible="prospection,analyse,audit,lot_validation,qualification"/>
                        <!--                        rescind,cancel-->
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Consulted" bg_color="text-bg-success"
                                invisible="not consultation_id"/>

                        <div class="oe_button_box" name="button_box">

                            <button name="show_documents" type="object" class="oe_stat_button"
                                    icon="fa-list-alt">
                                <div class="o_stat_info">

                                    <span class="o_stat_text">Documents</span>
                                </div>
                            </button>
                            <button name="show_purchase_order" type="object" class="oe_stat_button"
                                    icon="fa-list-alt" invisible="purchase_id == False">
                                <div class="o_stat_info">

                                    <span class="o_stat_text">PO Sample</span>
                                </div>
                            </button>
                            <button name="action_show_consultations" type="object"
                                    class="oe_stat_button"
                                    invisible="state not in ['homologue'] or not consultation_id "
                                    icon="fa-list-alt">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Consultations</span>
                                </div>
                            </button>

                        </div>
                        <group>

                            <group>

                                <field name="market_supplier_ids" invisible="1"/>
                                <field name="consultation_id" invisible="1"/>
                                <field name="supplier_id" readonly="state != 'prospection'" invisible="not market_id"
                                       domain="[('id', 'in', market_supplier_ids)]"/>
                                <field name="supplier_id" readonly="state != 'prospection'" invisible="market_id"/>
                                <field name="dw_supplier_nature" readonly="state == 'homologue'" required="1"/>
                                <field name="state_market" readonly="state == 'homologue'" invisible="1"/>
                                <label for="street"/>
                                <div>
                                    <field name="street" placeholder="Street..." readonly="state == 'homologue'"
                                           required="1" class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." readonly="state == 'homologue'"
                                           required="1" class="o_address_street"/>
                                    <field name="city" placeholder="City" readonly="state == 'homologue'" required="1"
                                           class="o_address_city"/>
                                    <div class="o_row">
                                        <field name="state_id" creadonly="state == 'homologue'" required="1"
                                               class="o_address_state" placeholder="State"
                                               options="{'no_open': True, 'no_quick_create': True}"
                                               context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                        <field name="zip" placeholder="ZIP" readonly="state == 'homologue'" required="0"
                                               class="o_address_zip"/>
                                    </div>
                                    <field name="country_id" placeholder="Country" class="o_address_country"
                                           readonly="state == 'homologue'" required="1"/>
                                </div>


                            </group>
                            <group>
                                <field name="market_id" readonly="state != 'prospection'"/>
                                <field name="product_id" readonly="state != 'prospection'" invisible="not market_id"
                                       domain="[('id', 'in', product_ids)]"/>
                                <field name="product_id" readonly="state != 'prospection'" invisible="market_id"/>
                                <field name="product_ids" invisible="1"/>
                                <field name="company_id" readonly="state != 'prospection'"/>
                                <field name="lot_validation" readonly="state not in ['analyse','prospection','audit']"/>
                                <field name="phone" widget="phone" required="1" readonly="state == 'homologue'"/>
                                <field name="email" widget="email" required="1" readonly="state == 'homologue'"/>
                                <field name="purchase_id" invisible="1"/>






                            </group>
                        </group>


                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_homologation_list">
            <field name="name">Homologation</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">dw.homologation</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree' , 'view_id': ref('dw_supplier_approval.view_homologation_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dw_supplier_approval.view_homologation_form')})]"/>
            <field name="domain">[('market_id','=',active_id)]</field>
            <field name="context">{
                "default_market_id":active_id,
                }
            </field>
        </record>


    </data>
</odoo>

