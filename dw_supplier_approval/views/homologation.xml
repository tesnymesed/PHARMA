<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_homologation_tree" model="ir.ui.view">
            <field name="name">dw.homologation.tree</field>
            <field name="model">dw.homologation</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="market_id" optional="show"/>
                    <field name="state" optional="show"/>
                    <field name="supplier_id" optional="show"/>
                    <field name="product_id" optional="show"/>
                    <field name="lot_validation" optional="show"/>


                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="view_homologation_form">
            <field name="name">dw.homologation.form</field>
            <field name="model">dw.homologation</field>

            <field name="arch" type="xml">
                <form string="Homologation">
                    <header>

                        <button name="action_to_analyse" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'prospection'"
                                type="object"/>
                        <button name="action_to_audit" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'analyse'"
                                type="object"/>
                        <button name="action_to_lot_validation_or_qualification" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'audit'"
                                type="object"/>
                        <button name="action_to_qualification" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'lot_validation'"
                                type="object"/>

                        <button name="action_homologuer" string="Homologuer"
                                class="btn-primary"
                                invisible="state in ['prospection','audit','lot_validation']"
                                type="object"/>

                        <button name="create_purchase_order" string="Create Purchase order"
                                class="btn-primary"
                                invisible="state != 'analyse'"
                                type="object"/>


                        <field name="state" widget="statusbar"
                               statusbar_visible="prospection,analyse,audit,lot_validation,qualification"/>
                        <!--                        rescind,cancel-->
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">

                            <button name="show_documents" type="object" class="oe_stat_button"
                                    icon="fa-list-alt">
                                <div class="o_stat_info">

                                    <span class="o_stat_text">Documents</span>
                                </div>
                            </button>
                            <button name="show_purchase_order" type="object" class="oe_stat_button"
                                    icon="fa-list-alt" invisible="purchase_id == False">
                                <div class="o_stat_info">

                                    <span class="o_stat_text">Purchase Order</span>
                                </div>
                            </button>

                        </div>
                        <group>

                            <group>

                                <field name="supplier_id"></field>
                                <label for="street"/>
                                <div>
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city"/>
                                    <div class="o_row">
                                        <field name="state_id" class="o_address_state" placeholder="State"
                                               options="{'no_open': True, 'no_quick_create': True}"
                                               context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    </div>
                                    <field name="country_id" placeholder="Country" class="o_address_country"/>
                                </div>


                            </group>
                            <group>
                                <field name="market_id"/>
                                <field name="product_id"/>
                                <field name="lot_validation"/>
                                <field name="purchase_id" invisible="1"/>
                                <field name="rapport_expertise_file_name" invisible="1"/>
                                <field name="rapport_expertise_attachment" widget="binary"
                                       invisible="state != 'analyse'" required="state == 'analyse'"
                                       filename="rapport_expertise_file_name"/>

                                <field name="rapport_audit_file_name" invisible="1"/>
                                <field name="rapport_audit_attachment" widget="binary" invisible="state != 'audit'"
                                       required="state == 'audit'"
                                       filename="rapport_audit_file_name"/>
                                <field name="fichier_stabilite_file_name" invisible="1"/>
                                <field name="fichier_stabilite_attachment" widget="binary"
                                       invisible="state != 'lot_validation'" required="state == 'lot_validation'"
                                       filename="fichier_stabilite_file_name"/>


                            </group>
                        </group>


                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>


    </data>
</odoo>

