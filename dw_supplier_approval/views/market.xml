<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--        purchase form -->
        <record id="dw_purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="supplier_homologuer_ids" widget="many2many_tags" invisible="1"/>
                    <field name="market_id"/>

                </xpath>
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="domain">[('id','in',supplier_homologuer_ids)]</attribute>
                </xpath>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_purchase_order_list">
            <field name="name">Purchase Orders</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('market_id','=',active_id)]</field>
            <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree' , 'view_id': ref('purchase.purchase_order_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dw_supplier_approval.dw_purchase_order_form_inherit')})]"/>
            <field name="context">{
                "default_market_id":active_id,
                }
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_homologation_list">
            <field name="name">Homologation</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">dw.homologation</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree' , 'view_id': ref('dw_supplier_approval.view_homologation_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dw_supplier_approval.view_homologation_form')})]"/>
            <field name="domain">[('market_id','=',active_id)]</field>
            <field name="context">{
                "default_market_id":active_id,
                }
            </field>
        </record>

        <!--  Market      -->

        <record id="kanban_dw_market" model="ir.ui.view">
            <field name="name">dw.market.kanban</field>
            <field name="model">dw.market</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column o_opportunity_kanban"
                        archivable="false" sample="1" js_class="crm_kanban" quick_create="False"
                        records_draggable="False">
                    <field name="name"/>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="user_id"/>
                    <field name="description"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o-title">
                                        <h4 style="font-size: 15px; text-align:center;">
                                            <field name="name"/>
                                        </h4>
                                    </div>
                                    <div>
                                        <span class="o_kanban_record_subtitle"><b>Product</b> :
                                            <field name="product_ids" widget="many2many_tags"/>
                                        </span>

                                          <span class="o_kanban_record_subtitle"><b>Responsible</b>:
                                            <field name="user_id" />
                                        </span>

                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>

                </kanban>
            </field>
        </record>
        <record id="view_market_tree" model="ir.ui.view">
            <field name="name">dw.market.tree</field>
            <field name="model">dw.market</field>
            <field name="priority" eval="2"/>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" optional="show"/>
                    <field name="state" optional="show"/>
                    <field name="description" optional="show"/>
                    <field name="company_id" optional="show"  />
                    <field name="user_id" optional="show"/>
                    <field name="product_ids" optional="show" widget="many2many_tags"/>
                    <field name="market_type_id"/>

                </tree>
            </field>
        </record>
        <record id="view_market_type_tree" model="ir.ui.view">
            <field name="name">dw.market.type.tree</field>
            <field name="model">dw.market.type</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name" optional="show"/>
                    <field name="code" optional="show"/>


                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_market_form">
            <field name="name">dw.market.form</field>
            <field name="model">dw.market</field>
            <field name="priority" eval="3"/>
            <field name="arch" type="xml">
                <form string="Market">
                    <header>
                        <button name="button_draft" string="return to draft"
                                class="btn-primary"
                                invisible="state != 'cancel' "
                                type="object"/>
                        <button name="action_homologation" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'draft'"
                                type="object"/>
                        <button name="action_done" string="Confirm"
                                class="btn-primary"
                                invisible="state != 'homologation_cosultation'"
                                type="object"/>


                        <button
                                name="action_cancel" string="Cancel"
                                type="object" class="btn-primary" data-hotkey="q"
                                invisible="state in ['draft','cancel','done'] "
                        />


                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,homologation_cosultation,done"/>
                        <!--                        rescind,cancel-->
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="show_documents" type="object" class="oe_stat_button"
                                    icon="fa-list-alt">
                                <div class="o_stat_info">

                                    <span class="o_stat_text">Documents</span>
                                </div>
                            </button>
                            <button name="%(dw_supplier_approval.action_purchase_order_list)d" type="action"
                                    class="oe_stat_button"
                                    invisible="state == 'draft' "
                                    icon="fa-list-alt">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Purchase Orders</span>
                                </div>
                            </button>
                            <button name="%(dw_supplier_approval.action_homologation_list)d" type="action"
                                    class="oe_stat_button"
                                     invisible="state == 'draft'"
                                    icon="fa-list-alt">
                                <div class="o_stat_info">

                                    <span class="o_stat_text">approvals</span>
                                </div>
                            </button>

                        </div>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group>
                            <group>
                                <field name="company_id" readonly="state != 'draft'"/>
                                <field name="product_ids" options='{"no_create":True}' widget="many2many_tags" readonly="state != 'draft'"/>
                                <field name="description" readonly="state != 'draft'"/>


                            </group>
                            <group>
                                <field name="user_id" readonly="state != 'draft'"/>

                                <field name="market_type_id" invisible="1" readonly="state != 'draft'"/>
                                <field name="supplier_homologuer_ids" widget="many2many_tags" invisible="1"/>

                            </group>

                        </group>
                        <div class="oe_button_box" name="button_box">
                        </div>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>

                    </div>
                </form>
            </field>
        </record>


    </data>
</odoo>