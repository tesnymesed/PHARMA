<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--  Market      -->
        <record model="ir.ui.view" id="view_market_form_inherit">
            <field name="name">dw.market.form.inherit</field>
            <field name="model">dw.market</field>
            <field name="priority" eval="3"/>
            <field name="inherit_id" ref="dw_procurement.view_market_form"/>

            <field name="arch" type="xml">

                <xpath expr="//button[@name='action_prospection']" position="after">
                    <button name="action_homologation" string="Confirm"
                            class="btn-primary"
                            invisible="state not in  ['prospection']"
                            type="object"/>
                    <button name="action_attribution_file" string="Load Attribution File"
                            class="btn-primary"
                            invisible="state not in  ['homologation_cosultation']"
                            type="object"/>
                    <button name="action_done" string="Assign"
                            class="btn-primary"
                            invisible="state not in  ['homologation_cosultation'] or not dw_homologate"
                            type="object"/>
                </xpath>
                <xpath expr="//sheet/div[@name='button_box']" position="inside">
                    <button name="action_show_homologations" type="object"
                            class="oe_stat_button"
                            invisible="state not in ['homologation_cosultation','done']"
                            icon="fa-list-alt">
                        <div class="o_stat_info">

                            <span class="o_stat_text">approvals</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='len_supplier_market']" position="before">
                    <field name="len_supplier_homologated_market" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='len_supplier_market']" position="after">
                    <field name="dw_homologate" invisible="1"/>

                </xpath>
                <xpath expr="//page/field[@name='market_line_ids'][2]/tree/field[@name='supplier_ids']"
                       position="after">
                    <field name="line_homlogated" column_invisible="1"/>

                    <button name="action_done" type="object" icon="fa-check"
                            invisible="line_homlogated or not supplier_ids"/>
                </xpath>
                <xpath expr="//button[@name='action_show_consultations']" position="attributes">
                    <attribute name="invisible">state not in ['homologation_cosultation','done']</attribute>
                </xpath>
                <xpath expr="//button[@name='action_show_consultations_tco']" position="attributes">
                    <attribute name="invisible">state not in ['homologation_cosultation','done']</attribute>
                </xpath>


            </field>
        </record>


    </data>
</odoo>