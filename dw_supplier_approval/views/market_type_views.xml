<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_market_type_tree" model="ir.ui.view">
            <field name="name">dw.market.type.tree</field>
            <field name="model">dw.market.type</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="forced_nbr_supplier"/>
                    <field name="nbr_supplier" readonly="not forced_nbr_supplier"/>
                </tree>
            </field>
        </record>

    </data>
</odoo>