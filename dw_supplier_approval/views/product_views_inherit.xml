<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--        search view de produit -->
        <record id="product_template_search_view_inherit" model="ir.ui.view">
            <field name="name">product.product.search.inherit</field>
            <field name="model">product.product</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="has_blacklisted_supplier2"/>
                    <field name="expired_approval2"/>
                    <field name="expired_contract2"/>
                </xpath>
                <xpath expr="//filter[@name='favorites']" position="after">
                     <separator/>

                    <filter string="Has blacklisted supplier" name="has_blacklist" domain="['|', '|',('need_approval', '=', True), ('categ_id.need_approval', '=', True),
                ('product_tmpl_id.need_approval', '=', True),('has_blacklisted_supplier2','=',True),('purchase_ok', '=', True)]"/>
                    <filter string="approval expires less than 18 month" name="expired_approval" domain="['|', '|',('need_approval', '=', True), ('categ_id.need_approval', '=', True),
                ('product_tmpl_id.need_approval', '=', True),('expired_approval2','=',True),('purchase_ok', '=', True)]"/>


                            <filter string="contract expires less than 18 month" name="expired_contract" domain="['|', '|',('need_approval', '=', True), ('categ_id.need_approval', '=', True),
                ('product_tmpl_id.need_approval', '=', True),('expired_contract2','=',True),('purchase_ok', '=', True)]"/>
                    <filter string="The product to be approved" name="need_approval" domain="[('need_approval', '=', True)]"/>
                </xpath>

            </field>
        </record>

        <record id="view_product_template_inherited" model="ir.ui.view">
            <field name="name">product.template.inherited</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="need_approval"/>
                </xpath>
                <div name="button_box" position="inside">

                    <button class="oe_stat_button" type="object" name="action_show_approvals" icon="fa-list-alt">
                        <div class="o_stat_info">

                            <span class="o_stat_text">approval</span>
                        </div>
                    </button>
                </div>
            </field>
        </record>
        <!--add approval in product_product -->
        <record id="product_normal_form_view_inherited" model="ir.ui.view">
            <field name="name">product.product.inherited</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="number_supplier" invisible="1" />
                    <field name="number_supplier2" invisible="1"/>
                    <field name="need_approval" invisible="not purchase_ok"/>
                    <field name="has_blacklisted_supplier" invisible="1"/>
                    <field name="expired_approval" invisible="1"/>
                    <field name="expired_contract" invisible="1"/>
                </xpath>
                <div name="button_box" position="inside">
                    <button class="oe_stat_button" type="object" name="action_show_approvals" icon="fa-list-alt">
                        <div class="o_stat_info">
                            <span class="o_stat_text">approval</span>
                        </div>
                    </button>
                </div>
            </field>
        </record>

        <!--add need_approval in product category -->
        <record id="inherit_product_category_form_view2" model="ir.ui.view">
            <field name="name">product.category.form</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='first']" position="inside">
                    <field name="need_approval"/>

                </xpath>
            </field>
        </record>

        <record id="view_identification_besoin_product_tree" model="ir.ui.view">
            <field name="name">product.identification.besoin.tree.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="mode">primary</field>
            <field name="arch" type="xml">


                <xpath expr="//field[@name='name']" position="after">

                     <field name="number_supplier2" optional="hide"/>
                     <field name="has_blacklisted_supplier" optional="hide"/>
                     <field name="expired_approval" optional="hide"/>
                     <field name="expired_contract" optional="hide"/>
                </xpath>
                <xpath expr="//tree" position="attributes">
                    <attribute name="create">0</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>