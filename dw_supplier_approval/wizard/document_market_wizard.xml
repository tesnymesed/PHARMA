<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="view_document_market_wizard" model="ir.ui.view">
        <field name="name">Document Market Wizard</field>
        <field name="model">dw.document.market.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>

                        <field name="state_market" invisible="1"></field>
                        <field name="market_id" invisible="1"></field>

                        <field name="fiche_specification_name" invisible="1"/>
                        <field name="fiche_specification_attachment" widget="binary" filename="fiche_specification_name"
                               invisible="state_market != 'draft'"/>

                        <field name="cahier_charge_name" invisible="1"/>
                        <field name="cahier_charge_attachment" widget="binary" filename="fiche_specification_name"
                               invisible="state_market != 'prospection'"/>

                        <field name="pv_attribution_name" invisible="1"/>
                        <field name="pv_attribution_attachment" widget="binary" filename="pv_attribution_name"
                               invisible="state_market != 'homologation_cosultation'"/>
                    </group>
                    <group></group>
                    <footer>
                        <button
                                name="action_confirm"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"

                        />
                        <button special="cancel" string="Cancel" class="oe_link"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>


</odoo>