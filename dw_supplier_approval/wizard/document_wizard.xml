<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="view_manufacturing_document_wizard" model="ir.ui.view">
        <field name="name">Document Fabriquant Wizard</field>
        <field name="model">dw.homologation</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                   <group >
                      <field name="manufacturing_file_name" invisible="1"/>
                       <field name="manufacturing_document_attachment" widget="binary" filename="manufacturing_file_name" required="1"/>
                   </group>
                    <group ></group>
                    <footer>
                        <button
                                name="action_confirm"
                                string="Confirm"
                                type="object"
                                 class="btn-primary"

                        />
                        <button special="cancel" string="Cancel" class="oe_link"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>



</odoo>