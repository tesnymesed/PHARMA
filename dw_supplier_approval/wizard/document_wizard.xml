<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="view_manufacturing_document_wizard" model="ir.ui.view">
        <field name="name">Document Fabriquant Wizard</field>
        <field name="model">dw.document.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="state_homologation"/>
                        <field name="homologation_id"/>
                        <field name="manufacturing_file_name" invisible="1"/>

                        <field name="manufacturing_document_attachment" widget="binary"
                               filename="manufacturing_file_name" invisible="state_homologation != 'prospection'"
                               required="state_homologation == 'prospection'"/>

                        <field name="rapport_expertise_file_name" invisible="1"/>
                        <field name="rapport_expertise_attachment" widget="binary"
                               invisible="state_homologation != 'analyse'" required="state_homologation == 'analyse'"
                               filename="rapport_expertise_file_name"/>
                        <field name="rapport_audit_file_name" invisible="1"/>
                        <field name="rapport_audit_attachment" widget="binary" invisible="state_homologation != 'audit'"
                               required="state_homologation == 'audit'"
                               filename="rapport_audit_file_name"/>

                        <field name="stabilite_file_name" invisible="1"/>
                        <field name="fichier_stabilite_attachment" widget="binary"
                               invisible="state_homologation != 'lot_validation'"
                               required="state_homologation == 'lot_validation'"
                               filename="stabilite_file_name"/>
                    </group>
                    <group></group>
                    <footer>
                        <button
                                name="action_manufacturing"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"
                                invisible="state_homologation != 'prospection'"
                        />

                        <button
                                name="action_expertise"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"
                                invisible="state_homologation != 'analyse'"
                        />
                        <button
                                name="action_audit"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"
                                invisible="state_homologation != 'audit'"
                        />
                        <button
                                name="action_stability"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"
                                invisible="state_homologation != 'lot_validation'"
                        />

                        <button special="cancel" string="Cancel" class="oe_link"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>


</odoo>