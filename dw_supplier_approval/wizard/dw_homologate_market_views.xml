<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="dw_homologate_market_form_view" model="ir.ui.view">
            <field name="name">Homologate Market Wizard</field>
            <field name="model">dw.homologate.market.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>

                            <field name="line_id" invisible="1"/>
                            <span>Homologate </span>
                        </group>
                        <footer>

                            <button
                                    name="action_create_homologation_confirm"
                                    string="Homologuer"
                                    type="object"
                                    class="btn-primary"/>
                            <button special="cancel" string="Cancel" class="oe_link"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>


    </data>
</odoo>